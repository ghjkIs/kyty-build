+void TestExpandedIndirectBufferReads() {
+  const std::array opcodes{ValueOpcode::LoadBufferU8, ValueOpcode::LoadBufferU16,
+                          ValueOpcode::LoadBufferU32, ValueOpcode::LoadBufferU32x2,
+                          ValueOpcode::LoadBufferU32x3, ValueOpcode::LoadBufferU32x4};
+  for (const auto opcode : opcodes) {
+    for (const bool formatted : {false, true}) {
+      const auto bits = opcode == ValueOpcode::LoadBufferU8 ? 8u
+                      : opcode == ValueOpcode::LoadBufferU16 ? 16u : 32u;
+      if (formatted && bits != 32u) continue;
+      Fixture fixture;
+      fixture.program.shader_hash = 0xfeed0001ull;
+      const auto lane = fixture.Emit(ValueOpcode::LaneId);
+      const auto handle = fixture.Buffer({lane, Value(0u), Value(64u), Value(0u)}, 0x84);
+      MemoryInfo memory;
+      memory.kind = ResourceKind::Buffer;
+      memory.data_bits = bits;
+      memory.data_dwords = BufferComponentCount(opcode);
+      memory.formatted = formatted;
+      const auto loaded = fixture.Emit(opcode,
+          {handle, Value(0u), Value(0u), Value(0u), Value(true)},
+          fixture.AddMemory(memory, 0x84));
+      // Keep the vector/subword result live without changing its type.
+      fixture.Emit(ValueOpcode::Reference, {loaded});
+      fixture.PlanAndTrack();
+      Check(fixture.program.memory_info[0].kind == ResourceKind::IndirectBuffer,
+            "GPU-dependent buffer read was not retained for execution on the GPU");
+      Check(fixture.program.info.uses_dma && fixture.program.info.buffers.empty(),
+            "indirect read incorrectly acquired a static buffer binding");
+      Check(handle.ResolveInstruction()->Arg(0).Resolve() == lane.Resolve(),
+            "indirect descriptor was replaced instead of preserved");
+    }
+  }
+  for (const auto opcode : {ValueOpcode::StoreBufferU32, ValueOpcode::BufferAtomicIAdd32}) {
+    Fixture fixture;
+    const auto handle = fixture.Buffer(
+        {fixture.Emit(ValueOpcode::LaneId), Value(0u), Value(64u), Value(0u)}, 0x84);
+    MemoryInfo memory;
+    memory.kind = ResourceKind::Buffer;
+    const auto operation = fixture.Emit(opcode,
+        {handle, Value(0u), Value(0u), Value(0u), Value(1u), Value(true)},
+        fixture.AddMemory(memory, 0x84));
+    if (operation.GetType() != Type::Void) fixture.Emit(ValueOpcode::Reference, {operation});
+    CheckFatal([&] { fixture.PlanAndTrack(); }, ValueOpcodeName(opcode),
+               "unsupported dynamic writes lost their opcode diagnostic");
+  }
+  MemoryInfo typed;
+  typed.typed = true;
+  Check(!typed.SupportsIndirectBufferLoad(ValueOpcode::LoadBufferU32),
+        "typed loads were enabled without a typed backend");
+}
