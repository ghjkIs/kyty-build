+  auto *first = fixture.AddBlock();
+  auto *second = fixture.AddBlock();
+  auto *merge = fixture.AddBlock();
+  entry->AddBranch(first);
+  entry->AddBranch(second);
+  first->AddBranch(merge);
+  second->AddBranch(merge);
+  entry->terminator = {.kind = CFG::TerminatorKind::ConditionalBranch,
+                       .true_block = first, .false_block = second};
+  first->terminator = {.kind = CFG::TerminatorKind::Branch, .true_block = merge};
+  second->terminator = {.kind = CFG::TerminatorKind::Branch, .true_block = merge};
+  merge->terminator.kind = CFG::TerminatorKind::Return;
+
+  std::array<Value, 12> user_data;
+  for (uint32_t index = 0; index < user_data.size(); index++) {
+    user_data[index] = fixture.UserData(index);
+  }
+  const auto control =
+      fixture.Buffer({Value(0x1000u), Value(0u), Value(16u), Value(0u)});
+  MemoryInfo scalar;
+  scalar.kind = ResourceKind::ScalarBuffer;
+  const auto read = [&](uint32_t offset, Block *block) {
+    return fixture.Emit(ValueOpcode::ReadConstBuffer, {control, Value(offset)},
+                        fixture.AddMemory(scalar, 0x7c), block);
+  };
+  MemoryInfo memory;
+  memory.kind = ResourceKind::Buffer;
+  memory.idxen = true;
+  if (mode == 2u) {
+    const auto prior = fixture.Buffer(
+        {Value(0x8000u), Value(0u), Value(16u), Value(0x16204u)}, 0x40);
+    fixture.Emit(ValueOpcode::StoreBufferU32,
+                 {prior, Value(0u), Value(0u), Value(0u), Value(1u), Value(true)},
+                 fixture.AddMemory(memory, 0x40), entry);
+  }
