+			const auto* inst = pending.back().Resolve().TryInstruction();
+			pending.pop_back();
+			if (inst == nullptr || !visited.insert(inst).second) continue;
+			if (visited.size() > 4096u) return false;
+			const auto* block = inst->Parent();
+			if (block == nullptr || OnCycleThrough(block, merge)) return false;
