+			return;
+		}
+		const auto base = Binary(state, spv::OpBitwiseAnd, TypeU64(state), buffer.address,
+		                         ConstantU64(state, ~uint64_t {3}));
+		for (uint32_t component = 0; component < components; ++component) {
+			uint32_t value = data;
