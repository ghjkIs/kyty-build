+	const Inst* FindTerminalStoreHandle() const {
+		// A descriptor computed before the sole, final write can use the same
+		// host resource-binding path as a straight-line scalar descriptor.
+		// Do not extend this to loops, read-after-write, or multiple writes.
+		const Inst* store = nullptr;
+		std::map<const Block*, uint32_t> remaining;
+		std::vector<const Block*> ready;
+		for (const auto* block: m_program.blocks) {
+			remaining[block] = static_cast<uint32_t>(block->ImmPredecessors().size());
+			if (block->ImmPredecessors().empty()) ready.push_back(block);
+			bool after_store = false;
+			for (const auto& inst: *block) {
+				if (after_store) return nullptr;
+				const auto op = inst.GetOpcode();
+				const auto buffer = BufferAccessOf(op);
+				const auto image = ImageOpcodeInfoOf(op).access;
+				if (buffer != BufferAccess::Write && buffer != BufferAccess::Atomic &&
+				    image != ImageAccess::Write && image != ImageAccess::Atomic &&
+				    AddressOpcodeInfoOf(op).access != AddressAccess::Write) continue;
+				if (store != nullptr || op != ValueOpcode::StoreBufferU32 ||
+				    !block->ImmSuccessors().empty() ||
+				    block->terminator.kind != CFG::TerminatorKind::Return) return nullptr;
+				store = &inst;
+				after_store = true;
+			}
+		}
+		if (store == nullptr) return nullptr;
+		for (size_t i = 0; i < ready.size(); ++i) {
+			for (const auto* next: ready[i]->ImmSuccessors()) {
+				auto found = remaining.find(next);
+				if (found == remaining.end() || found->second == 0) return nullptr;
+				if (--found->second == 0) ready.push_back(next);
+			}
+		}
+		if (ready.size() != m_program.blocks.size()) return nullptr;
+		return store->Arg(0).ResolveInstruction();
+	}
+
+	// Structural checks shared by every host-side descriptor Phi lowering: a
+	// two-arm diamond (or triangle) whose branch condition and both incoming
+	// values are uniform runtime values (LaneId and other per-lane values fail
+	// ValidateRuntimeValue).
+	bool UniformDescriptorDiamond(const Inst& phi, const Block*& branch,
+	                              std::array<const Block*, 2>& targets) const {
+		if (phi.GetOpcode() != ValueOpcode::Phi || phi.NumArgs() != 2u ||
+		    phi.NumPhiBlocks() != 2u || phi.GetType() != Type::U32) {
+			return false;
 		}
-		for (const auto& [original, selected]: m_descriptor_selections) {
-			if (original == phi) {
-				return selected;
-			}
+		const auto* merge = phi.Parent();
+		branch = phi.PhiBlock(0);
+		if (merge == nullptr || branch == nullptr || phi.PhiBlock(1) == nullptr ||
+		    branch == phi.PhiBlock(1)) {
+			return false;
 		}
 		if (branch->ImmSuccessors().size() != 2u) {
 			if (branch->ImmPredecessors().size() != 1u) {
-				return value;
+				return false;
 			}
 			branch = branch->ImmPredecessors()[0];
 		}
 		if (branch == merge || branch->ImmSuccessors().size() != 2u) {
-			return value;
+			return false;
 		}
-		std::array<const Block*, 2> targets;
 		for (uint32_t arm = 0; arm < 2; arm++) {
-			const auto* incoming = phi->PhiBlock(arm);
+			const auto* incoming = phi.PhiBlock(arm);
 			if (incoming == merge ||
 			    (incoming != branch &&
 			     (incoming->ImmPredecessors().size() != 1u ||
 			      incoming->ImmPredecessors()[0] != branch ||
 			      incoming->ImmSuccessors().size() != 1u ||
 			      incoming->ImmSuccessors()[0] != merge))) {
-				return value;
+				return false;
 			}
 			targets[arm] = incoming == branch ? merge : incoming;
 		}
-		const auto& info = *branch;
-		const auto& term = info.terminator;
-		if (term.kind != CFG::TerminatorKind::ConditionalBranch ||
-		    !((term.true_block == targets[0] && term.false_block == targets[1]) ||
-		      (term.false_block == targets[0] && term.true_block == targets[1])) ||
-		    !ValidateRuntimeValue(m_program, info.condition, RuntimeValueType::Integer) ||
-		    !ValidateRuntimeValue(m_program, phi->Arg(0)) ||
-		    !ValidateRuntimeValue(m_program, phi->Arg(1))) {
+		const auto& term = branch->terminator;
+		return term.kind == CFG::TerminatorKind::ConditionalBranch &&
+		       ((term.true_block == targets[0] && term.false_block == targets[1]) ||
+		        (term.false_block == targets[0] && term.true_block == targets[1])) &&
+		       ValidateRuntimeValue(m_program, branch->condition, RuntimeValueType::Integer) &&
+		       ValidateRuntimeValue(m_program, phi.Arg(0)) &&
+		       ValidateRuntimeValue(m_program, phi.Arg(1));
