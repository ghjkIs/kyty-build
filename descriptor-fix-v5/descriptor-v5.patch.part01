+
+	static bool WritesMemory(const Inst& inst) {
+		const auto op = inst.GetOpcode();
+		const auto buffer = BufferAccessOf(op);
+		const auto image = ImageOpcodeInfoOf(op).access;
+		return buffer == BufferAccess::Write || buffer == BufferAccess::Atomic ||
+		       image == ImageAccess::Write || image == ImageAccess::Atomic ||
+		       AddressOpcodeInfoOf(op).access == AddressAccess::Write;
+	}
+
+	static bool Reaches(const Block* from, const Block* to) {
+		std::vector<const Block*> pending {from};
+		std::set<const Block*> seen;
+		while (!pending.empty()) {
+			const auto* block = pending.back();
+			pending.pop_back();
+			if (!seen.insert(block).second) continue;
+			if (block == to) return true;
+			const auto next = block->ImmSuccessors();
+			pending.insert(pending.end(), next.begin(), next.end());
+		}
+		return false;
+	}
+
+	// V4 (#1224): Phis reachable from a descriptor word through side-effect-free
+	// uniform operations (S_BITSET1, S_LSHL, S_ADD, ...). The walk is bounded.
+	static std::vector<const Inst*> DescriptorWordPhis(Value word) {
+		std::vector<const Inst*> phis;
+		std::vector<Value> pending {word};
+		std::set<const Inst*> visited;
+		while (!pending.empty() && visited.size() < 256u) {
+			const auto* inst = pending.back().Resolve().TryInstruction();
+			pending.pop_back();
+			if (inst == nullptr || !visited.insert(inst).second) continue;
+			if (inst->GetOpcode() == ValueOpcode::Phi) {
+				phis.push_back(inst);
+				continue;
+			}
+			if (!IsRuntimeUniformOp(inst->GetOpcode())) continue;
+			for (size_t index = 0; index < inst->NumArgs(); ++index)
+				pending.push_back(inst->Arg(index));
+		}
+		return phis;
+	}
+
+	// V4 (#1224): shader writes may alias scalar memory (including on a later
+	// loop visit) but never user data. A branch condition that reads no memory
+	// cannot observe this shader's writes. Conservative: unknown => reads memory.
+	static bool ReadsMemory(Value value) {
+		std::vector<Value> pending {value};
+		std::set<const Inst*> visited;
+		while (!pending.empty()) {
+			const auto* inst = pending.back().Resolve().TryInstruction();
+			pending.pop_back();
+			if (inst == nullptr || !visited.insert(inst).second) continue;
+			if (visited.size() > 4096u) return true;
+			const auto op = inst->GetOpcode();
+			if (op == ValueOpcode::ReadConst || op == ValueOpcode::ReadConstBuffer ||
+			    AddressOpcodeInfoOf(op).access != AddressAccess::None ||
+			    BufferAccessOf(op) != BufferAccess::None ||
+			    ImageOpcodeInfoOf(op).access != ImageAccess::None) {
+				return true;
+			}
+			for (size_t index = 0; index < inst->NumArgs(); index++)
+				pending.push_back(inst->Arg(index));
+		}
+		return false;
+	}
+
+	// V5-B: raw buffer loads whose V# may come from a host-lowered descriptor Phi.
+	// ReadConstBuffer stays with the scalar planner; formatted/typed loads are
+	// filtered later by memory metadata exactly as for a straight-line V#.
+	static bool IsRawBufferLoad(ValueOpcode op) {
+		switch (op) {
+			case ValueOpcode::LoadBufferU8:
+			case ValueOpcode::LoadBufferU16:
+			case ValueOpcode::LoadBufferU32:
+			case ValueOpcode::LoadBufferU32x2:
+			case ValueOpcode::LoadBufferU32x3:
+			case ValueOpcode::LoadBufferU32x4: return true;
+			default: return false;
+		}
+	}
+
+	// V5-B: true when 'block' lies on a cycle through 'merge'. Only meaningful
+	// when merge itself is on a cycle (Reaches(merge, branch)).
+	static bool OnCycleThrough(const Block* block, const Block* merge) {
+		return Reaches(merge, block) && Reaches(block, merge);
+	}
+
