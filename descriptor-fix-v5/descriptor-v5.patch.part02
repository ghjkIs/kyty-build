e.dwords[0] != 0x2000u) { value = candidate; found = true; }
+    }
+    Check(found, "terminal store descriptor missing");
+    Check(value.dwords[0]==(flag ? 0x3000u:0x4000u) &&
+          value.dwords[1]==((flag ? 1u:2u)|0x40000u),
+          "terminal store selected wrong base or lost stride flag");
+  }
+  }
+  // Sole terminal store with a memory predicate: V2 rule still accepts.
+  TerminalStorePlan(0, true);
+  for (unsigned mode : {1u,3u})
+    CheckFatal([&]{TerminalStorePlan(mode);},"not a valid runtime value",
+               "unsafe writable descriptor selection accepted");
+  // Memory predicate plus an earlier write: neither V2, V3 nor #1224 applies.
+  for (unsigned mode : {2u,4u})
+    CheckFatal([&]{TerminalStorePlan(mode, true);},"not a valid runtime value",
+               "memory-predicated writable descriptor selection accepted");
+}
+
+// V3: Ace Combat 8 CS 0x1d81bb2b74faf456 merges a scalar buffer address in a
+// uniform diamond, ORs a flag into the high word, and feeds several
+// BufferAtomicOr32 sites (plus unrelated stores) from the same Phi.
+// V4: expr 0 = hi | flag; 1 = (hi + 0x10) | flag; 2 = also lo << 4.
+ResourcePlan UniformAtomicPlan(unsigned rejected_case = 0,
+                               ValueOpcode atomic_op = ValueOpcode::BufferAtomicOr32,
+                               bool memory_condition = false, unsigned expr = 0) {
+  namespace CFG = Libs::Graphics::ShaderRecompiler::CFG;
+  Fixture f;
+  auto* entry = f.block;
+  auto* left = f.AddBlock();
+  auto* right = f.AddBlock();
+  auto* merge = f.AddBlock();
+  auto* tail = f.AddBlock();
+  entry->AddBranch(left); entry->AddBranch(right);
+  left->AddBranch(merge); right->AddBranch(merge);
+  merge->AddBranch(tail);
+  entry->terminator = {.kind=CFG::TerminatorKind::ConditionalBranch,
+                      .true_block=left, .false_block=right};
+  left->terminator = {.kind=CFG::TerminatorKind::Branch, .true_block=merge};
+  right->terminator = {.kind=CFG::TerminatorKind::Branch, .true_block=merge};
+  merge->terminator = {.kind=CFG::TerminatorKind::Branch, .true_block=tail};
+  if (rejected_case == 4) {
+    // Write-free loop around the diamond; all writes happen after the loop exits.
+    merge->AddBranch(entry);
+    merge->terminator = {.kind=CFG::TerminatorKind::ConditionalBranch,
+                        .true_block=tail, .false_block=entry};
+    merge->condition = f.Emit(ValueOpcode::INotEqual32, {f.UserData(1), Value(0u)});
+  }
+  auto address = f.Address(Value(0x1000u), Value(0u));
+  auto read = [&](Block* block, uint32_t offset) {
+    MemoryInfo m; m.kind=ResourceKind::ScalarAddress; m.offset=offset;
+    return f.Emit(ValueOpcode::LoadAddressU32,
+        {address, Value(0u), Value(0u), Value(true)}, f.AddMemory(m, 0x10+offset), block);
+  };
+  // V4: memory_condition selects the arm with a scalar memory read (words[4])
+  // instead of user data; shader writes may then alias the predicate.
+  entry->condition = rejected_case == 1 ? f.Emit(ValueOpcode::ULessThan32,
+      {f.Emit(ValueOpcode::LaneId), Value(1u)}) :
+      f.Emit(ValueOpcode::INotEqual32,
+             {memory_condition ? read(entry, 16) : f.UserData(0), Value(0u)});
+  auto lo0=read(left,0), hi0=read(left,4);
+  auto lo1=read(right,8), hi1=read(right,12);
+  auto& lo=merge->AppendNewInst(ValueOpcode::Phi, {}, uint64_t(Type::U32));
+  lo.AddPhiOperand(left,lo0); lo.AddPhiOperand(right,lo1);
+  auto& hi=merge->AppendNewInst(ValueOpcode::Phi, {}, uint64_t(Type::U32));
+  hi.AddPhiOperand(left,hi0); hi.AddPhiOperand(right,hi1);
+  const auto high_input = expr >= 1u
+      ? f.Emit(ValueOpcode::IAdd32,{Value(&hi),Value(0x10u)},0,merge) : Value(&hi);
+  auto high=f.Emit(ValueOpcode::BitwiseOr32,{high_input,Value(0x40000u)},0,merge);
+  const auto low = expr == 2u
+      ? f.Emit(ValueOpcode::ShiftLeftLogical32,{Value(&lo),Value(4u)},0,merge) : Value(&lo);
+  MemoryInfo m; m.kind=ResourceKind::Buffer;
+  if (rejected_case == 2) {
+    // A write before the descriptor reads could alias them; host values would be stale.
+    auto prior=f.Buffer({Value(0x2000u),Value(0x40000u),Value(100u),Value(0x16204u)});
+    f.Emit(ValueOpcode::StoreBufferU32,
+        {prior,Value(0u),Value(0u),Value(0u),Value(0u),Value(true)},f.AddMemory(m,4),entry);
+  }
+  // Unrelated straight-line store between the atomics: V2's sole-terminal-store
+  // rule rejects this shape, V3 must not.
+  auto other=f.Buffer({f.UserData(6),Value(0x400000u),Value(100u),Value(0x10016204u)});
+  f.Emit(ValueOpcode::StoreBufferU32,
+      {other,Value(0u),Value(0u),Value(0u),Value(5u),Value(true)},f.AddMemory(m,0x90),
+      rejected_case == 4 ? tail : merge);
+  std::vector<Value> handles;
+  for (uint32_t site = 0; site < 2u; ++site) {
+    auto* block = site == 0 && rejected_case != 4 ? merge : tail;
+    const uint32_t pc = 0x1a0u + site * 0xc0u;
+    auto handle=f.Emit(ValueOpcode::GetBufferResource,
+        {low,high,Value(100u),Value(0x16204u)},MemoryFlags{0,pc},block);
+    // Result unused, as in the shader; the atomic itself is a side effect.
+    f.Emit(atomic_op,
+        {handle,Value(1u),Value(0u),Value(0u),Value(0u),Value(true)},f.AddMemory(m,pc),block);
+    handles.push_back(handle);
+  }
+  if (rejected_case == 3) {
+    tail->AddBranch(entry);
+    tail->terminator={.kind=CFG::TerminatorKind::Branch,.true_block=entry};
+  }
+  f.PlanAndTrack();
+  Check(lo.GetOpcode()==ValueOpcode::Phi && hi.GetOpcode()==ValueOpcode::Phi &&
+        high.Instruction()->Arg(0).Resolve()==high_input.Resolve() &&
+        handles[0].Instruction()->Arg(0).Resolve()==low.Resolve() &&
+        handles[1].Instruction()->Arg(0).Resolve()==low.Resolve() &&
+        (expr == 0u || high_input.Instruction()->Arg(0).Instruction()==&hi) &&
+        (expr != 2u || low.Instruction()->Arg(0).Instruction()==&lo),
+        "uniform atomic planning changed GPU SSA");
+  Check(f.program.info.buffers.size()==(rejected_case == 2 ? 3u : 2u),
+        "uniform atomic descriptor was not shared by both atomic sites");
+  Check(handles[0].Instruction()->Flags<uint32_t>()==handles[1].Instruction()->Flags<uint32_t>(),
+        "atomic sites using the same Phi were bound to different buffers");
+  const auto& atomic_buffer=f.program.info.buffers[handles[0].Instruction()->Flags<uint32_t>()];
+  Check(atomic_buffer.written && atomic_buffer.atomic && atomic_buffer.read,
+        "uniform atomic descriptor lost its writable/atomic buffer binding");
+  for (const auto& memory : f.program.memory_info)
+    Check(memory.kind!=ResourceKind::IndirectBuffer,
+          "uniform atomic descriptor fell back to an indirect buffer");
+  EliminateDeadCode(f.program.blocks);
+  ValidateProgram(f.program,true);
+  return ExtractResourcePlan(f.program);
+}
+
+void CheckUniformAtomicPlan(const ResourcePlan& plan, bool memory_condition, unsigned expr) {
+  uint32_t atomic_index = UINT32_MAX;
+  for (uint32_t index = 0; index < plan.info.buffers.size(); ++index)
+    if (plan.info.buffers[index].atomic) {
+      Check(atomic_index == UINT32_MAX, "uniform atomic descriptor bound twice");
+      atomic_index = index;
+    }
+  Check(atomic_index != UINT32_MAX, "uniform atomic descriptor not bound");
+  for (uint32_t flag : {0u,1u}) {
+    TestMemory memory; memory.words={0x3000u,1u,0x4000u,2u,0u};
+    std::array<uint32_t,64> user{}; user[6]=0x9000u;
+    if (memory_condition) memory.words[4]=flag; else user[0]=flag;
+    SrtRuntime runtime{.user_data=user,.read_memory=ReadTestMemory,.userdata=&memory,
+                       .read_specialization_memory=ReadTestMemory};
+    DescriptorValue value;
+    SrtWalker clean(plan,CleanRuntime(runtime));
+    Check(SrtWalker(plan,runtime,&clean).EvaluateDescriptor(
+              plan.info.buffers[atomic_index].source,value),
+          "uniform atomic descriptor evaluation failed");
+    const uint32_t lo = flag ? 0x3000u : 0x4000u;
+    const uint32_t hi = (flag ? 1u : 2u) + (expr >= 1u ? 0x10u : 0u);
+    Check(value.dwords[0]==(expr == 2u ? lo << 4u : lo) &&
+          value.dwords[1]==(hi|0x40000u),
+          "uniform atomic descriptor selected wrong base or lost flag");
+  }
+}
+
+void TestUniformAtomicDescriptorPhi() {
+  for (const auto op : {ValueOpcode::BufferAtomicOr32, ValueOpcode::BufferAtomicIAdd32})
+    CheckUniformAtomicPlan(UniformAtomicPlan(0, op), false, 0);
+  // V4 (b): memory predicate, nothing written before the diamond -> V3 rule.
+  CheckUniformAtomicPlan(UniformAtomicPlan(0, ValueOpcode::BufferAtomicOr32, true), true, 0);
+  // V4 (a): user-data predicate with a write before the diamond -> #1224 rule.
+  CheckUniformAtomicPlan(UniformAtomicPlan(2), false, 0);
+  // V4 (d): general uniform expressions over the Phis, via both rules.
+  for (unsigned expr : {1u,2u}) {
+    CheckUniformAtomicPlan(UniformAtomicPlan(0, ValueOpcode::BufferAtomicOr32, false, expr),
+                           false, expr);
+    CheckUniformAtomicPlan(UniformAtomicPlan(0, ValueOpcode::BufferAtomicOr32, true, expr),
+                           true, expr);
+    CheckUniformAtomicPlan(UniformAtomicPlan(2, ValueOpcode::BufferAtomicOr32, false, expr),
+                           false, expr);
+  }
+  for (unsigned mode : {1u,3u,4u})
+    CheckFatal([&]{UniformAtomicPlan(mode);},"not a valid runtime value",
+               "unsafe atomic descriptor selection accepted");
+  // V4 (c): memory predicate plus a write before the diamond -> neither rule.
+  CheckFatal([&]{UniformAtomicPlan(2, ValueOpcode::BufferAtomicOr32, true);},
+             "not a valid runtime value",
+             "memory-predicated atomic descriptor after a write accepted");
+  CheckFatal([&]{UniformAtomicPlan(2, ValueOpcode::BufferAtomicOr32, true, 2);},
+             "not a valid runtime value",
+             "memory-predicated atomic expression after a write accepted");
+  CheckFatal([&]{UniformAtomicPlan(1u);},"opcode=BufferAtomicOr32",
+             "lane-dependent atomic descriptor lost its opcode diagnostic");
+}
+
+// V5-B: Ace Combat 8 CS 0xe41c5e833516362b merges a scalar V# in a uniform
+// diamond (Block $4) and feeds LoadBufferU16 (Block $11) in a shader with
+// three loops and buffer writes. The Phi must host-lower to a bound buffer
+// instead of falling back to an IndirectBuffer BDA read.
+// shape 0: acyclic diamond, unrelated write loop after it (Ace shape).
+// shape 1: diamond inside a loop that writes; condition and V# words are read
+//          in the preheader (loop-invariant) -> accepted.
+// shape 2: like 1, but the V# words are read inside the loop arms (carried
+//          per iteration) -> rejected (IndirectBuffer).
+// shape 3: like 1, but the condition is read inside the loop -> rejected.
+// shape 4: lane-dependent condition -> rejected.
+// shape 5: acyclic, memory predicate after a write -> rejected.
+bool UniformLoadPlan(unsigned shape, ValueOpcode load_op, ResourcePlan* out = nullptr) {
+  namespace CFG = Libs::Graphics::ShaderRecompiler::CFG;
+  Fixture f;
+  auto* entry = f.block;
+  const bool loop = shape >= 1u && shape <= 3u;
+  auto* header = loop ? f.AddBlock() : entry;
+  auto* left = f.AddBlock();
+  auto* right = f.AddBlock();
+  auto* merge = f.AddBlock();
+  auto* tail = f.AddBlock();
+  auto* exit = f.AddBlock();
+  if (loop) {
+    entry->AddBranch(header);
+    entry->terminator = {.kind=CFG::TerminatorKind::Branch, .true_block=header};
+  }
+  header->AddBranch(left); header->AddBranch(right);
+  left->AddBranch(merge); right->AddBranch(merge);
+  header->terminator = {.kind=CFG::TerminatorKind::ConditionalBranch,
+                        .true_block=left, .false_block=right};
+  left->terminator = {.kind=CFG::TerminatorKind::Branch, .true_block=merge};
+  right->terminator = {.kind=CFG::TerminatorKind::Branch, .true_block=merge};
+  if (loop) {
+    merge->AddBranch(tail); merge->AddBranch(header);
+    merge->terminator = {.kind=CFG::TerminatorKind::ConditionalBranch,
+                         .true_block=tail, .false_block=header};
+    merge->condition = f.Emit(ValueOpcode::INotEqual32, {f.UserData(1), Value(0u)}, 0, merge);
+  } else {
+    merge->AddBranch(tail);
+    merge->terminator = {.kind=CFG::TerminatorKind::Branch, .true_block=tail};
+  }
+  if (!loop) {
+    // Unrelated write loop after the diamond (shader-level loop).
+    tail->AddBranch(tail); tail->AddBranch(exit);
+    tail->terminator = {.kind=CFG::TerminatorKind::ConditionalBranch,
+                        .true_block=tail, .false_block=exit};
+    tail->condition = f.Emit(ValueOpcode::INotEqual32, {f.UserData(2), Value(0u)}, 0, tail);
+  } else {
+    tail->AddBranch(exit);
+    tail->terminator = {.kind=CFG::TerminatorKind::Branch, .true_block=exit};
+  }
+  exit->terminator = {.kind=CFG::TerminatorKind::Return};
+  auto address = f.Address(Value(0x1000u), Value(0u));
+  auto read = [&](Block* block, uint32_t offset) {
+    MemoryInfo m; m.kind=ResourceKind::ScalarAddress; m.offset=offset;
+    return f.Emit(ValueOpcode::LoadAddressU32,
+        {address, Value(0u), Value(0u), Value(true)}, f.AddMemory(m, 0x10+offset), block);
+  };
+  MemoryInfo store_memory; store_memory.kind=ResourceKind::Buffer;
+  if (shape == 5u) {
+    auto prior=f.Buffer({Value(0x2000u),Value(0x40000u),Value(100u),Value(0x16204u)});
+    f.Emit(ValueOpcode::StoreBufferU32,
+        {prior,Value(0u),Value(0u),Value(0u),Value(0u),Value(true)},
+        f.AddMemory(store_memory,4),entry);
+  }
+  // Memory predicate everywhere, so #1224's "condition reads no memory" rule
+  // cannot be what accepts the Phi.
+  Block* cond_block = shape == 3u ? header : entry;
+  header->condition = shape == 4u
+      ? f.Emit(ValueOpcode::ULessThan32, {f.Emit(ValueOpcode::LaneId), Value(1u)})
+      : f.Emit(ValueOpcode::INotEqual32, {read(cond_block, 16), Value(0u)}, 0, cond_block);
+  Block* words_left = shape == 2u ? left : entry;
+  Block* words_right = shape == 2u ? right : entry;
+  auto lo0=read(words_left,0), hi0=read(words_left,4);
+  auto lo1=read(words_right,8), hi1=read(words_right,12);
+  auto& lo=merge->AppendNewInst(ValueOpcode::Phi, {}, uint64_t(Type::U32));
+  lo.AddPhiOperand(left,lo0); lo.AddPhiOperand(right,lo1);
+  auto& hi=merge->AppendNewInst(ValueOpcode::Phi, {}, uint64_t(Type::U32));
+  hi.AddPhiOperand(left,hi0); hi.AddPhiOperand(right,hi1);
+  auto high=f.Emit(ValueOpcode::BitwiseOr32,{Value(&hi),Value(0x40000u)},0,merge);
+  auto handle=f.Emit(ValueOpcode::GetBufferResource,
+      {Value(&lo),high,Value(100u),Value(0x16204u)},MemoryFlags{0,0x130u},merge);
+  MemoryInfo m; m.kind=ResourceKind::Buffer;
+  m.data_bits = load_op == ValueOpcode::LoadBufferU8 ? 8u
+              : load_op == ValueOpcode::LoadBufferU16 ? 16u : 32u;
+  m.data_dwords = BufferComponentCount(load_op);
+  auto loaded=f.Emit(load_op,{handle,Value(0u),Value(0u),Value(0u),Value(true)},
+                     f.AddMemory(m,0x140u),merge);
+  f.Emit(ValueOpcode::Reference,{loaded},0,merge);
+  // A shader write: inside the loop for loop shapes, in the trailing loop otherwise.
+  auto other=f.Buffer({f.UserData(6),Value(0x400000u),Value(100u),Value(0x10016204u)});
+  f.Emit(ValueOpcode::StoreBufferU32,
+      {other,Value(0u),Value(0u),Value(0u),Value(5u),Value(true)},
+      f.AddMemory(store_memory,0x90), loop ? merge : tail);
+  f.PlanAndTrack();
+  Check(lo.GetOpcode()==ValueOpcode::Phi && hi.GetOpcode()==ValueOpcode::Phi &&
+        handle.Instruction()->Arg(0).Resolve()==Value(&lo),
+        "uniform load planning changed GPU SSA");
+  const auto load_memory = loaded.Instruction()->Flags<MemoryFlags>().index;
+  const bool bound = f.program.memory_info[load_memory].kind == ResourceKind::Buffer;
+  if (!bound) {
+    Check(f.program.memory_info[load_memory].kind == ResourceKind::IndirectBuffer &&
+          f.program.info.uses_dma, "rejected load Phi did not fall back to IndirectBuffer");
+    return false;
+  }
+  // No ValidateProgram: the Reference that keeps a U16/vector load live is
+  // only type-valid for U1 (as in TestExpandedIndirectBufferReads).
+  if (out != nullptr) *out = ExtractResourcePlan(f.program);
+  const auto resource = handle.Instruction()->Flags<uint32_t>();
+  Check(resource < f.program.info.buffers.size() &&
+        f.program.info.buffers[resource].read && !f.program.info.buffers[resource].written,
+        "uniform load descriptor lost its read-only buffer binding");
+  return true;
+}
+
+void CheckUniformLoadPlan(const ResourcePlan& plan) {
+  uint32_t load_index = UINT32_MAX;
+  for (uint32_t index = 0; index < plan.info.buffers.size(); ++index)
+    if (!plan.info.buffers[index].written) load_index = index;
+  Check(load_index != UINT32_MAX, "uniform load descriptor not bound");
+  for (uint32_t flag : {0u,1u}) {
+    TestMemory memory; memory.words={0x3000u,1u,0x4000u,2u,flag};
+    std::array<uint32_t,64> user{}; user[6]=0x9000u;
+    SrtRuntime runtime{.user_data=user,.read_memory=ReadTestMemory,.userdata=&memory,
+                       .read_specialization_memory=ReadTestMemory};
+    DescriptorValue value;
+    SrtWalker clean(plan,CleanRuntime(runtime));
+    Check(SrtWalker(plan,runtime,&clean).EvaluateDescriptor(
+              plan.info.buffers[load_index].source,value),
+          "uniform load descriptor evaluation failed");
+    Check(value.dwords[0]==(flag ? 0x3000u : 0x4000u) &&
+          value.dwords[1]==((flag ? 1u : 2u)|0x40000u),
+          "uniform load descriptor selected wrong base or lost flag");
+  }
+}
+
+void TestUniformLoadDescriptorPhi() {
+  for (const auto op : {ValueOpcode::LoadBufferU16, ValueOpcode::LoadBufferU8,
+                        ValueOpcode::LoadBufferU32, ValueOpcode::LoadBufferU32x2,
+                        ValueOpcode::LoadBufferU32x3, ValueOpcode::LoadBufferU32x4}) {
+    for (unsigned shape : {0u,1u}) {
+      ResourcePlan plan;
+      Check(UniformLoadPlan(shape, op, &plan),
+            "uniform load descriptor Phi was not host-lowered");
+      CheckUniformLoadPlan(plan);
+    }
+  }
+  for (unsigned shape : {2u,3u,4u,5u})
+    Check(!UniformLoadPlan(shape, ValueOpcode::LoadBufferU16),
+          "unsafe load descriptor selection was host-lowered");
+}
+
 void TestWritableDescriptorPhi() {
   Fixture fixture;
   auto *left = fixture.block;
@@ -3206,6 +3617,141 @@ void TestGuardedScalarDescriptorReads() {
   }
 }
 
+// Ported from KytyPS5 PR #1224 (TheCruZ). GTA V CS d03361dd03166145 selects the
+// base of an atomic V# with S_CBRANCH_SCC0 on s2, adds it with S_ADD_U32/S_ADDC_U32
+// in each arm, sets a flag on the merged high word with S_BITSET1_B32, and also
+// stores through another buffer.
+// V4 modes: 0 = user-data predicate (#1224 rule); 1 = scalar-memory predicate with
+// no write before the diamond (V3 uniform-atomic rule; #1224 alone rejects it);
+// 2 = scalar-memory predicate after a store in the entry block (rejected).
+ResourcePlan WrittenScalarBranchBufferPlan(unsigned mode) {
+  namespace CFG = Libs::Graphics::ShaderRecompiler::CFG;
+  Fixture fixture;
+  auto *entry = fixture.block;
+  auto *first = fixture.AddBlock();
+  auto *second = fixture.AddBlock();
+  auto *merge = fixture.AddBlock();
+  entry->AddBranch(first);
+  entry->AddBranch(second);
+  first->AddBranch(merge);
+  second->AddBranch(merge);
+  entry->terminator = {.kind = CFG::TerminatorKind::ConditionalBranch,
+                       .true_block = first, .false_block = second};
+  first->terminator = {.kind = CFG::TerminatorKind::Branch, .true_block = merge};
+  second->terminator = {.kind = CFG::TerminatorKind::Branch, .true_block = merge};
+  merge->terminator.kind = CFG::TerminatorKind::Return;
+
+  std::array<Value, 12> user_data;
+  for (uint32_t index = 0; index < user_data.size(); index++) {
+    user_data[index] = fixture.UserData(index);
+  }
+  const auto control =
+      fixture.Buffer({Value(0x1000u), Value(0u), Value(16u), Value(0u)});
+  MemoryInfo scalar;
+  scalar.kind = ResourceKind::ScalarBuffer;
+  const auto read = [&](uint32_t offset, Block *block) {
+    return fixture.Emit(ValueOpcode::ReadConstBuffer, {control, Value(offset)},
+                        fixture.AddMemory(scalar, 0x7c), block);
+  };
+  MemoryInfo memory;
+  memory.kind = ResourceKind::Buffer;
+  memory.idxen = true;
+  if (mode == 2u) {
+    const auto prior = fixture.Buffer(
+        {Value(0x8000u), Value(0u), Value(16u), Value(0x16204u)}, 0x40);
+    fixture.Emit(ValueOpcode::StoreBufferU32,
+                 {prior, Value(0u), Value(0u), Value(0u), Value(1u), Value(true)},
+                 fixture.AddMemory(memory, 0x40), entry);
+  }
+  const auto selector = mode != 0u ? read(4u, entry) : user_data[2];
+  entry->condition = fixture.Emit(ValueOpcode::IEqual32, {Value(0u), selector}, 0, entry);
+
+  const auto add_carry = [&](Value low, Value low_addend, Value high,
+                             Block *block) {
+    const auto sum =
+        fixture.Emit(ValueOpcode::IAddCarry32, {low, low_addend}, 0, block);
+    const auto carry = fixture.Emit(
+        ValueOpcode::SelectU32,
+        {fixture.Emit(ValueOpcode::INotEqual32,
+                      {fixture.Emit(ValueOpcode::CompositeExtractU32x2,
+                                    {sum, Value(1u)}, 0, block),
+                       Value(0u)},
+                      0, block),
+         Value(1u), Value(0u)},
+        0, block);
+    return std::pair{
+        fixture.Emit(ValueOpcode::CompositeExtractU32x2, {sum, Value(0u)}, 0,
+                     block),
+        fixture.Emit(ValueOpcode::IAdd32, {high, carry}, 0, block)};
+  };
+  const auto [first_low, first_high] =
+      add_carry(user_data[4], user_data[5], user_data[1], first);
+  const auto [second_low, second_high] =
+      add_carry(user_data[3], read(0u, second), user_data[0], second);
+  std::array<Value, 2> base;
+  for (uint32_t word = 0; word < base.size(); word++) {
+    auto &phi = merge->AppendNewInst(ValueOpcode::Phi, {},
+                                     static_cast<uint64_t>(Type::U32));
+    phi.AddPhiOperand(first, word == 0 ? first_low : first_high);
+    phi.AddPhiOperand(second, word == 0 ? second_low : second_high);
+    base[word] = Value(&phi);
+  }
+  fixture.block = merge;
+  const auto high =
+      fixture.Emit(ValueOpcode::BitwiseOr32, {base[1], Value(0x40000u)});
+  const auto flags =
+      fixture.Buffer({base[0], high, user_data[6], Value(0x16204u)}, 0x1a8);
+  fixture.Emit(ValueOpcode::BufferAtomicOr32,
+               {flags, Value(1u), Value(0u), Value(0u), Value(0u), Value(true)},
+               fixture.AddMemory(memory, 0x1a8));
+  const auto output = fixture.Buffer(
+      {user_data[8], user_data[9], user_data[10], user_data[11]}, 0x190);
+  fixture.Emit(ValueOpcode::StoreBufferU32,
+               {output, Value(0u), Value(0u), Value(0u), Value(1u), Value(true)},
+               fixture.AddMemory(memory, 0x190));
+  fixture.PlanAndTrack();
+  Check(flags.ResolveInstruction()->Arg(0).ResolveInstruction()->GetOpcode() ==
+            ValueOpcode::Phi &&
+        high.ResolveInstruction()->Arg(0).ResolveInstruction()->GetOpcode() ==
+            ValueOpcode::Phi,
+        "host descriptor selection changed the GPU Phi");
+  EliminateDeadCode(fixture.program.blocks);
+  ValidateProgram(fixture.program, true);
+  return ExtractResourcePlan(fixture.program);
+}
+
+void TestWrittenScalarBranchBuffer() {
+  for (const unsigned mode : {0u, 1u}) {
+    auto plan = WrittenScalarBranchBufferPlan(mode);
+    Check(!plan.info.uses_dma, "scalar-branch V# fell back to DMA");
+    const auto buffer = std::ranges::find_if(
+        plan.info.buffers, [](const BufferResource &resource) { return resource.atomic; });
+    Check(buffer != plan.info.buffers.end(), "scalar-branch V# was not bound");
+    std::array<uint32_t, 12> user_data{7u,          0x12u,  0u, 0x5000u,
+                                       0xfffff000u, 0x2000u, 0x100u};
+    TestMemory memory;
+    memory.words[0] = 0xfffffd00u;
+    const SrtRuntime runtime{.user_data = user_data,
+                             .read_memory = ReadTestMemory,
+                             .userdata = &memory};
+    for (const bool taken : {true, false}) {
+      if (mode == 0u) user_data[2] = taken ? 0u : 1u;
+      else memory.words[1] = taken ? 0u : 1u;
+      DescriptorValue value;
+      Check(SrtWalker(plan, runtime).EvaluateDescriptor(buffer->source, value),
+            "scalar-branch V# was not evaluated");
+      // Both arms carry into the high word.
+      Check(value.dwords[0] == (taken ? 0x1000u : 0x4d00u) &&
+                value.dwords[1] == (taken ? 0x40013u : 0x40008u) &&
+                value.dwords[2] == 0x100u && value.dwords[3] == 0x16204u,
+            "scalar-branch V# chose the wrong incoming base");
+    }
+  }
+  CheckFatal([] { WrittenScalarBranchBufferPlan(2u); },
+             "not a valid runtime value",
+             "shader-written scalar predicate selected a V#");
+}
