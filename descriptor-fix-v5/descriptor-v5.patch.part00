diff --git a/CMakeLists.txt b/CMakeLists.txt
index c8f7700..e257040 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -294,7 +294,22 @@ add_custom_command(
 	DEPENDS "${fault_buffer_shader_source}"
 	VERBATIM
 )
+# Descriptor fix V4 Layer B: the same compaction shader with room for 65536 written pages.
+set(bda_write_shader_spv "${gpu_tiler_generated_dir}/bda_write_process.spv")
+set(bda_write_shader_header "${gpu_tiler_generated_dir}/bda_write_process_spv.h")
+add_custom_command(
+	OUTPUT "${bda_write_shader_header}"
+	COMMAND ${CMAKE_COMMAND} -E make_directory "${gpu_tiler_generated_dir}"
+	COMMAND "${KYTY_GLSLANG_VALIDATOR}" -V --target-env vulkan1.3 -Os
+	        -DCACHING_PAGEBITS=14 -DMAX_PAGE_FAULTS=65536
+	        -o "${bda_write_shader_spv}" "${fault_buffer_shader_source}"
+	COMMAND ${CMAKE_COMMAND} -DINPUT=${bda_write_shader_spv} -DOUTPUT=${bda_write_shader_header}
+	        -DSYMBOL=BDA_WRITE_PROCESS_SPV -P "${KYTY_SOURCE_DIR}/embed_spirv.cmake"
+	DEPENDS "${fault_buffer_shader_source}"
+	VERBATIM
+)
 list(APPEND kyty_emulator_src "${fault_buffer_shader_header}")
+list(APPEND kyty_emulator_src "${bda_write_shader_header}")
 list(APPEND kyty_emulator_src ${gpu_tiler_shader_headers})
 
 set(gpu_blit_generated_dir "${PROJECT_BINARY_DIR}/gpu_blit_shaders")
diff --git a/src/graphics/host_gpu/renderer/cache/bufferCache.cpp b/src/graphics/host_gpu/renderer/cache/bufferCache.cpp
index 165e32e..1d3ad41 100644
--- a/src/graphics/host_gpu/renderer/cache/bufferCache.cpp
+++ b/src/graphics/host_gpu/renderer/cache/bufferCache.cpp
@@ -673,6 +673,28 @@ void BufferCache::ProcessFaultBuffer() {
 	m_fault_manager.ProcessFaultBuffer();
 }
 
+void BufferCache::MarkBdaWritten(uint64_t vaddr, uint64_t size) {
+	// A BDA write can only reach bytes that a cache buffer backs through the page table. The
+	// buffer already holds the written bytes, so mark them GPU-dirty (a later CPU access or
+	// specialization read downloads them) and invalidate images over the same memory, as the
+	// bound writable-buffer path does when it binds.
+	const auto end = vaddr + size;
+	auto       it  = m_buffers.upper_bound(vaddr);
+	if (it != m_buffers.begin()) {
+		--it;
+	}
+	for (; it != m_buffers.end() && it->first < end; ++it) {
+		const auto& buffer = m_slot_buffers[it->second];
+		const auto  start  = std::max(buffer.CpuAddress(), vaddr);
+		const auto  finish = std::min(buffer.CpuAddress() + buffer.Size(), end);
+		if (start < finish) {
+			m_memory_tracker.MarkRegionAsGpuModified(start, finish - start);
+			m_gpu_modified_ranges.Add(start, finish - start);
+			m_texture_cache.InvalidateMemoryFromGPU(start, finish - start);
+		}
+	}
+}
+
 void BufferCache::SynchronizeBuffersInRange(uint64_t vaddr, uint64_t size) {
 	const auto end = vaddr + size;
 	auto       it  = m_buffers.upper_bound(vaddr);
