+			                                 reads.front().first, reads.front().second, 0, 0,
+			                                 "BDA writes")) {
+				EXIT("scalar resource reads cannot be proven disjoint from shader BDA writes\n");
+			}
 		}
 		for (const auto [address, size]: reads) {
 			for (const auto id: m_bound_images) {
@@ -1029,8 +1075,12 @@ void RenderExecutor::CommitBindings(CommandBuffer&                     buffer,
 				for (const auto& resource: program.info.buffers) {
 					if (!resource.written || resource.descriptor_index == UINT32_MAX) continue;
 					const auto& written = writer->buffer_sources[resource.descriptor_index];
-					if (written.size != 0 && ImageRangeOverlaps(address, size,
-					                                          written.address, written.size)) {
+					if (written.size != 0 &&
+					    ImageRangeOverlaps(address, size, written.address, written.size) &&
+					    !AllowComputeSnapshotOverlap(*reader->runtime->program,
+					                                 prepared_bindings.size(), address, size,
+					                                 written.address, written.size,
+					                                 "bound buffer")) {
 						EXIT("scalar resource reads overlap a shader buffer write\n");
