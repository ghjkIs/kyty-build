 	[[nodiscard]] bool IsRegionGpuModified(uint64_t vaddr, uint64_t size);
 	void               ProcessFaultBuffer();
+	// Descriptor fix V4 Layer B (KYTY_BDA_WRITES).
+	[[nodiscard]] bool BdaWritesEnabled() const noexcept { return m_fault_manager.BdaWritesEnabled(); }
+	void               PrepareBdaWrites() { m_fault_manager.PrepareBdaWrites(); }
+	void               SettleBdaWrites(uint64_t shader_hash) { m_fault_manager.SettleBdaWrites(shader_hash); }
+	// Marks bytes of cache buffers in [vaddr, vaddr + size) as written by the GPU through BDA.
+	void               MarkBdaWritten(uint64_t vaddr, uint64_t size);
 	void               SynchronizeBuffersInRange(uint64_t vaddr, uint64_t size);
 	void               RunGarbageCollector();
 
