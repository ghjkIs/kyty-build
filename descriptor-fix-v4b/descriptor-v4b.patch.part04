+  MemoryInfo m; m.kind=ResourceKind::Buffer;
+  if (rejected_case == 2) {
+    // A write before the descriptor reads could alias them; host values would be stale.
+    auto prior=f.Buffer({Value(0x2000u),Value(0x40000u),Value(100u),Value(0x16204u)});
+    f.Emit(ValueOpcode::StoreBufferU32,
+        {prior,Value(0u),Value(0u),Value(0u),Value(0u),Value(true)},f.AddMemory(m,4),entry);
+  }
+  // Unrelated straight-line store between the atomics: V2's sole-terminal-store
+  // rule rejects this shape, V3 must not.
+  auto other=f.Buffer({f.UserData(6),Value(0x400000u),Value(100u),Value(0x10016204u)});
+  f.Emit(ValueOpcode::StoreBufferU32,
+      {other,Value(0u),Value(0u),Value(0u),Value(5u),Value(true)},f.AddMemory(m,0x90),
+      rejected_case == 4 ? tail : merge);
+  std::vector<Value> handles;
+  for (uint32_t site = 0; site < 2u; ++site) {
+    auto* block = site == 0 && rejected_case != 4 ? merge : tail;
+    const uint32_t pc = 0x1a0u + site * 0xc0u;
+    auto handle=f.Emit(ValueOpcode::GetBufferResource,
+        {low,high,Value(100u),Value(0x16204u)},MemoryFlags{0,pc},block);
+    // Result unused, as in the shader; the atomic itself is a side effect.
+    f.Emit(atomic_op,
+        {handle,Value(1u),Value(0u),Value(0u),Value(0u),Value(true)},f.AddMemory(m,pc),block);
+    handles.push_back(handle);
+  }
+  if (rejected_case == 3) {
+    tail->AddBranch(entry);
+    tail->terminator={.kind=CFG::TerminatorKind::Branch,.true_block=entry};
+  }
+  f.PlanAndTrack();
+  Check(lo.GetOpcode()==ValueOpcode::Phi && hi.GetOpcode()==ValueOpcode::Phi &&
+        high.Instruction()->Arg(0).Resolve()==high_input.Resolve() &&
+        handles[0].Instruction()->Arg(0).Resolve()==low.Resolve() &&
+        handles[1].Instruction()->Arg(0).Resolve()==low.Resolve() &&
+        (expr == 0u || high_input.Instruction()->Arg(0).Instruction()==&hi) &&
+        (expr != 2u || low.Instruction()->Arg(0).Instruction()==&lo),
+        "uniform atomic planning changed GPU SSA");
+  Check(f.program.info.buffers.size()==(rejected_case == 2 ? 3u : 2u),
+        "uniform atomic descriptor was not shared by both atomic sites");
+  Check(handles[0].Instruction()->Flags<uint32_t>()==handles[1].Instruction()->Flags<uint32_t>(),
+        "atomic sites using the same Phi were bound to different buffers");
+  const auto& atomic_buffer=f.program.info.buffers[handles[0].Instruction()->Flags<uint32_t>()];
+  Check(atomic_buffer.written && atomic_buffer.atomic && atomic_buffer.read,
+        "uniform atomic descriptor lost its writable/atomic buffer binding");
+  for (const auto& memory : f.program.memory_info)
+    Check(memory.kind!=ResourceKind::IndirectBuffer,
+          "uniform atomic descriptor fell back to an indirect buffer");
+  EliminateDeadCode(f.program.blocks);
+  ValidateProgram(f.program,true);
+  return ExtractResourcePlan(f.program);
+}
+
+void CheckUniformAtomicPlan(const ResourcePlan& plan, bool memory_condition, unsigned expr) {
+  uint32_t atomic_index = UINT32_MAX;
+  for (uint32_t index = 0; index < plan.info.buffers.size(); ++index)
+    if (plan.info.buffers[index].atomic) {
+      Check(atomic_index == UINT32_MAX, "uniform atomic descriptor bound twice");
+      atomic_index = index;
+    }
+  Check(atomic_index != UINT32_MAX, "uniform atomic descriptor not bound");
+  for (uint32_t flag : {0u,1u}) {
+    TestMemory memory; memory.words={0x3000u,1u,0x4000u,2u,0u};
+    std::array<uint32_t,64> user{}; user[6]=0x9000u;
+    if (memory_condition) memory.words[4]=flag; else user[0]=flag;
+    SrtRuntime runtime{.user_data=user,.read_memory=ReadTestMemory,.userdata=&memory,
+                       .read_specialization_memory=ReadTestMemory};
+    DescriptorValue value;
+    SrtWalker clean(plan,CleanRuntime(runtime));
+    Check(SrtWalker(plan,runtime,&clean).EvaluateDescriptor(
+              plan.info.buffers[atomic_index].source,value),
+          "uniform atomic descriptor evaluation failed");
+    const uint32_t lo = flag ? 0x3000u : 0x4000u;
+    const uint32_t hi = (flag ? 1u : 2u) + (expr >= 1u ? 0x10u : 0u);
+    Check(value.dwords[0]==(expr == 2u ? lo << 4u : lo) &&
+          value.dwords[1]==(hi|0x40000u),
+          "uniform atomic descriptor selected wrong base or lost flag");
+  }
+}
+
+void TestUniformAtomicDescriptorPhi() {
+  for (const auto op : {ValueOpcode::BufferAtomicOr32, ValueOpcode::BufferAtomicIAdd32})
+    CheckUniformAtomicPlan(UniformAtomicPlan(0, op), false, 0);
+  // V4 (b): memory predicate, nothing written before the diamond -> V3 rule.
+  CheckUniformAtomicPlan(UniformAtomicPlan(0, ValueOpcode::BufferAtomicOr32, true), true, 0);
+  // V4 (a): user-data predicate with a write before the diamond -> #1224 rule.
+  CheckUniformAtomicPlan(UniformAtomicPlan(2), false, 0);
+  // V4 (d): general uniform expressions over the Phis, via both rules.
+  for (unsigned expr : {1u,2u}) {
+    CheckUniformAtomicPlan(UniformAtomicPlan(0, ValueOpcode::BufferAtomicOr32, false, expr),
+                           false, expr);
+    CheckUniformAtomicPlan(UniformAtomicPlan(0, ValueOpcode::BufferAtomicOr32, true, expr),
+                           true, expr);
+    CheckUniformAtomicPlan(UniformAtomicPlan(2, ValueOpcode::BufferAtomicOr32, false, expr),
+                           false, expr);
+  }
+  for (unsigned mode : {1u,3u,4u})
+    CheckFatal([&]{UniformAtomicPlan(mode);},"not a valid runtime value",
+               "unsafe atomic descriptor selection accepted");
+  // V4 (c): memory predicate plus a write before the diamond -> neither rule.
+  CheckFatal([&]{UniformAtomicPlan(2, ValueOpcode::BufferAtomicOr32, true);},
+             "not a valid runtime value",
+             "memory-predicated atomic descriptor after a write accepted");
+  CheckFatal([&]{UniformAtomicPlan(2, ValueOpcode::BufferAtomicOr32, true, 2);},
+             "not a valid runtime value",
+             "memory-predicated atomic expression after a write accepted");
+  CheckFatal([&]{UniformAtomicPlan(1u);},"opcode=BufferAtomicOr32",
+             "lane-dependent atomic descriptor lost its opcode diagnostic");
+}
