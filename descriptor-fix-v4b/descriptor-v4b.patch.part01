+uint32_t LoadIndirectSubwordBuffer(ValueEmitContext& ctx, const IR::Inst& inst) {
+	auto& state = ctx.state;
+	return EmitValueOrZeroIfCondition(state, ctx.Arg(inst, inst.NumArgs() - 1), [&]() {
+		const auto buffer = PrepareIndirectBuffer(ctx, inst);
+		const auto bits = ctx.Memory(inst).data_bits;
+		const auto valid_format = Binary(state, spv::OpINotEqual, TypeBool(state), buffer.format,
+		                                 ConstantU32(state, 0));
+		return LoadBda(ctx, buffer.address,
+		    AndCondition(state, valid_format,
+		                 IndirectBufferInBounds(state, buffer, 0u, bits / 8u, false)),
+		    bits, ctx.Memory(inst).coherent);
+	});
+}
+
+// ---- Descriptor fix V4 Layer B: BDA writes through GPU-computed V#s (KYTY_BDA_WRITES) ----
+// Hand port of the Jetsku dbe6e32d idea onto upstream's BDA page table and fault buffer:
+// - every write goes through the BDA page table to a PhysicalStorageBuffer pointer;
+// - the written page is recorded in a second bitmap that follows the fault bitmap, and the
+//   renderer settles those pages (marks them GPU-dirty) right after the dispatch;
+// - a page without a cache buffer drops the write and records a normal BDA fault, so a later
+//   dispatch finds a buffer; KYTY_BDA_STORE_LOG counts such drops.
+// Range checks follow the BDA loads: stores per DWORD, atomics all-or-nothing (0 when out of
+// range); a DWORD address ignores its low two bits; bytes/shorts replace their bits of the
+// containing DWORD atomically.
+constexpr uint32_t BdaWrittenBitmapWord =
+    static_cast<uint32_t>(BufferCache::CACHING_NUMPAGES / 32u);
+constexpr uint32_t BdaTailWord = 2u * BdaWrittenBitmapWord;
+
+uint32_t BdaPageIndex(EmitterState& state, uint32_t address) {
+	const auto type     = TypeU64(state);
+	const auto extended = Binary(state, spv::OpUGreaterThanEqual, TypeBool(state), address,
+	                             ConstantU64(state, LibKernel::Memory::kExtendedMemoryBase));
+	const auto packed   = Select(
+	    state, type, extended,
+	    Binary(state, spv::OpISub, type, address,
+	           ConstantU64(state, LibKernel::Memory::kExtendedMemoryBase - LOWER_ADDRESS_SIZE)),
+	    address);
+	return Unary(state, spv::OpUConvert, TypeU32(state),
+	             Binary(state, spv::OpShiftRightLogical, type, packed,
+	                    ConstantU32(state, BufferCache::CACHING_PAGEBITS)));
+}
+
+void MarkBdaWrittenPage(EmitterState& state, uint32_t address) {
+	const auto page = BdaPageIndex(state, address);
+	const auto word = Binary(state, spv::OpIAdd, TypeU32(state),
+	                         Binary(state, spv::OpShiftRightLogical, TypeU32(state), page,
+	                                ConstantU32(state, 5)),
+	                         ConstantU32(state, BdaWrittenBitmapWord));
+	const auto bit =
+	    Binary(state, spv::OpShiftLeftLogical, TypeU32(state), ConstantU32(state, 1),
+	           Binary(state, spv::OpBitwiseAnd, TypeU32(state), page, ConstantU32(state, 31)));
+	state.builder.AddFunction(spv::OpAtomicOr, TypeU32(state), state.builder.AllocateId(),
+	                          FaultElementPointer(state, word), ConstantU32(state, spv::ScopeDevice),
+	                          ConstantU32(state, spv::MemorySemanticsMaskNone), bit);
+}
+
+void RecordDroppedBdaWrite(EmitterState& state, uint32_t address) {
+	if (!IR::BdaStoreLogEnabled()) return;
+	const auto page = BdaPageIndex(state, address);
+	state.builder.AddFunction(
+	    spv::OpAtomicIAdd, TypeU32(state), state.builder.AllocateId(),
+	    FaultElementPointer(state,
+	                        ConstantU32(state, BdaTailWord + IR::BdaFaultLayout::DroppedCountWord)),
+	    ConstantU32(state, spv::ScopeDevice), ConstantU32(state, spv::MemorySemanticsMaskNone),
+	    ConstantU32(state, 1));
+	state.builder.AddFunction(
+	    spv::OpAtomicExchange, TypeU32(state), state.builder.AllocateId(),
+	    FaultElementPointer(state,
+	                        ConstantU32(state, BdaTailWord + IR::BdaFaultLayout::DroppedPageWord)),
+	    ConstantU32(state, spv::ScopeDevice), ConstantU32(state, spv::MemorySemanticsMaskNone),
+	    Binary(state, spv::OpIAdd, TypeU32(state), page, ConstantU32(state, 1)));
+}
+
+// Runs fn(physical u32 pointer) when the DWORD at the 4-byte aligned address has a cache buffer.
+template <typename Fn>
+void WithBdaWritePointer(EmitterState& state, uint32_t aligned, Fn&& fn) {
+	const auto bda     = GetBdaPointer(state, aligned);
+	const auto present = Binary(state, spv::OpINotEqual, TypeBool(state), bda, ConstantU64(state, 0));
+	EmitIfCondition(state, present, [&]() {
+		const auto pointer = state.builder.AllocateId();
+		state.builder.AddFunction(spv::OpConvertUToPtr, TypePhysicalU32Pointer(state), pointer, bda);
+		fn(pointer);
+		MarkBdaWrittenPage(state, aligned);
+	});
+	if (IR::BdaStoreLogEnabled()) {
+		EmitIfCondition(state, Unary(state, spv::OpLogicalNot, TypeBool(state), present),
+		                [&]() { RecordDroppedBdaWrite(state, aligned); });
+	}
+}
+
+template <typename Fn>
+uint32_t EmitIndirectAtomicAccess(ValueEmitContext& ctx, const IR::Inst& inst, Fn&& operation) {
+	auto&      state  = ctx.state;
+	const auto buffer = PrepareIndirectBuffer(ctx, inst);
+	const auto valid_format =
+	    Binary(state, spv::OpINotEqual, TypeBool(state), buffer.format, ConstantU32(state, 0));
+	const auto in_bounds =
+	    AndCondition(state, valid_format, IndirectBufferInBounds(state, buffer, 0u, 4u, false));
+	return EmitValueOrZeroIfCondition(state, in_bounds, [&]() {
+		const auto aligned = Binary(state, spv::OpBitwiseAnd, TypeU64(state), buffer.address,
+		                            ConstantU64(state, ~uint64_t {3}));
+		const auto bda     = GetBdaPointer(state, aligned);
+		const auto present =
+		    Binary(state, spv::OpINotEqual, TypeBool(state), bda, ConstantU64(state, 0));
+		if (IR::BdaStoreLogEnabled()) {
+			EmitIfCondition(state, Unary(state, spv::OpLogicalNot, TypeBool(state), present),
+			                [&]() { RecordDroppedBdaWrite(state, aligned); });
+		}
+		return EmitValueOrZeroIfCondition(state, present, [&]() {
+			const auto pointer = state.builder.AllocateId();
+			state.builder.AddFunction(spv::OpConvertUToPtr, TypePhysicalU32Pointer(state), pointer,
+			                          bda);
+			const auto old = operation(pointer);
+			MarkBdaWrittenPage(state, aligned);
+			return old;
+		});
+	});
+}
+
+void StoreIndirectBuffer(ValueEmitContext& ctx, const IR::Inst& inst, uint32_t components) {
+	auto& state = ctx.state;
+	EmitIfCondition(state, ctx.Arg(inst, inst.NumArgs() - 1), [&]() {
+		const auto& mem    = ctx.Memory(inst);
+		const auto  buffer = PrepareIndirectBuffer(ctx, inst);
+		const auto  data   = ctx.Arg(inst, inst.NumArgs() - 2);
+		const auto  valid_format =
+		    Binary(state, spv::OpINotEqual, TypeBool(state), buffer.format, ConstantU32(state, 0));
+		const auto bits = mem.data_bits;
+		if (bits == 8u || bits == 16u) {
+			const auto in_bounds = AndCondition(
+			    state, valid_format, IndirectBufferInBounds(state, buffer, 0u, bits / 8u, false));
+			EmitIfCondition(state, in_bounds, [&]() {
+				const auto aligned = Binary(state, spv::OpBitwiseAnd, TypeU64(state), buffer.address,
+				                            ConstantU64(state, ~uint64_t {3}));
+				const auto low  = Unary(state, spv::OpUConvert, TypeU32(state), buffer.address);
+				const auto shift = Binary(state, spv::OpShiftLeftLogical, TypeU32(state),
+				                          Binary(state, spv::OpBitwiseAnd, TypeU32(state), low,
+				                                 ConstantU32(state, 3)),
+				                          ConstantU32(state, 3));
+				const auto lane_mask = ConstantU32(state, bits == 8u ? 0xffu : 0xffffu);
+				const auto mask  = Binary(state, spv::OpShiftLeftLogical, TypeU32(state), lane_mask, shift);
+				const auto value = Binary(state, spv::OpShiftLeftLogical, TypeU32(state),
