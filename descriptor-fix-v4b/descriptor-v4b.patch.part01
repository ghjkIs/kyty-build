+uint32_t LoadIndirectFormattedBuffer(ValueEmitContext& ctx, const IR::Inst& inst,
+                                      uint32_t components) {
+	std::array<uint32_t, 4> values {};
+	for (uint32_t component = 0; component < components; ++component)
