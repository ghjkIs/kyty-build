+				after_store = true;
+			}
+		}
+		if (store == nullptr) return nullptr;
+		for (size_t i = 0; i < ready.size(); ++i) {
+			for (const auto* next: ready[i]->ImmSuccessors()) {
+				auto found = remaining.find(next);
+				if (found == remaining.end() || found->second == 0) return nullptr;
+				if (--found->second == 0) ready.push_back(next);
+			}
+		}
+		if (ready.size() != m_program.blocks.size()) return nullptr;
+		return store->Arg(0).ResolveInstruction();
+	}
+
