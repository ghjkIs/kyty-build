diff --git a/src/graphics/shader/recompiler/ir/BdaWrites.h b/src/graphics/shader/recompiler/ir/BdaWrites.h
new file mode 100644
index 0000000..d2b8327
--- /dev/null
+++ b/src/graphics/shader/recompiler/ir/BdaWrites.h
@@ -0,0 +1,75 @@
+#ifndef EMULATOR_SRC_GRAPHICS_SHADER_RECOMPILER_IR_BDAWRITES_H_
+#define EMULATOR_SRC_GRAPHICS_SHADER_RECOMPILER_IR_BDAWRITES_H_
+
+// Descriptor fix V4 Layer B: experimental BDA writes through GPU-computed buffer descriptors.
+//
+// KYTY_BDA_WRITES (read once per process; there is no on-disk shader cache to invalidate):
+//   unset / "1" / "on"  - enabled (default of the V4B experimental build)
+//   "0" / "off"         - disabled; upstream behaviour (no BDA writes, scalar/write overlap EXITs)
+//   "verify"            - enabled, and dropped or overflowing BDA writes become fatal
+// KYTY_BDA_STORE_LOG (default off): count stores/atomics through a computed V# that hit a page
+//   without a cache buffer (the write is dropped; the page faults in for later dispatches) and
+//   log the count after each BDA-writing dispatch.
+
+#include <cstdlib>
+#include <cstring>
+#include <optional>
+
+namespace Libs::Graphics::ShaderRecompiler::IR {
+
+enum class BdaWritesMode { Off, On, Verify };
+
+// Tests may force a mode before the first query.
+inline std::optional<BdaWritesMode>& BdaWritesOverride() {
+	static std::optional<BdaWritesMode> mode;
+	return mode;
+}
+
+inline BdaWritesMode BdaWritesFromEnvironment() {
+	const char* value = std::getenv("KYTY_BDA_WRITES");
+	if (value == nullptr || value[0] == '\0') return BdaWritesMode::On;
+	if (std::strcmp(value, "0") == 0 || std::strcmp(value, "off") == 0 ||
+	    std::strcmp(value, "OFF") == 0 || std::strcmp(value, "false") == 0) {
+		return BdaWritesMode::Off;
+	}
+	if (std::strcmp(value, "verify") == 0 || std::strcmp(value, "VERIFY") == 0) {
+		return BdaWritesMode::Verify;
+	}
+	return BdaWritesMode::On;
+}
+
+inline BdaWritesMode GetBdaWritesMode() {
+	if (const auto& forced = BdaWritesOverride(); forced.has_value()) return *forced;
+	static const BdaWritesMode mode = BdaWritesFromEnvironment();
+	return mode;
+}
+
+inline bool BdaWritesEnabled() {
+	return GetBdaWritesMode() != BdaWritesMode::Off;
+}
+
+inline bool BdaWritesVerify() {
+	return GetBdaWritesMode() == BdaWritesMode::Verify;
+}
+
+inline bool BdaStoreLogEnabled() {
+	static const bool enabled = [] {
+		const char* value = std::getenv("KYTY_BDA_STORE_LOG");
+		return value != nullptr && value[0] != '\0' && std::strcmp(value, "0") != 0 &&
+		       std::strcmp(value, "off") != 0;
+	}();
+	return enabled && BdaWritesEnabled();
+}
+
+// Layout of the fault buffer when BDA writes are enabled. The first bitmap is upstream's
+// page-fault bitmap; the second marks pages written through BDA by the current dispatch;
+// the tail holds the dropped-write counter (KYTY_BDA_STORE_LOG) and the first dropped page.
+struct BdaFaultLayout {
+	static constexpr uint32_t DroppedCountWord = 0; // relative to the tail
+	static constexpr uint32_t DroppedPageWord  = 1;
+	static constexpr uint32_t TailWords        = 64; // keeps the tail 256-byte aligned
+};
+
+} // namespace Libs::Graphics::ShaderRecompiler::IR
+
+#endif // EMULATOR_SRC_GRAPHICS_SHADER_RECOMPILER_IR_BDAWRITES_H_
