+					    constexpr uint32_t alignment = sizeof(uint32_t);
+					    state.builder.AddFunction(spv::OpStore, pointer, value,
+					                              spv::MemoryAccessAlignedMask, alignment);
+				    });
+			    });
+		}
+	});
+}
