+	const Inst* FindTerminalStoreHandle() const {
+		// A descriptor computed before the sole, final write can use the same
+		// host resource-binding path as a straight-line scalar descriptor.
+		// Do not extend this to loops, read-after-write, or multiple writes.
+		const Inst* store = nullptr;
+		std::map<const Block*, uint32_t> remaining;
+		std::vector<const Block*> ready;
+		for (const auto* block: m_program.blocks) {
+			remaining[block] = static_cast<uint32_t>(block->ImmPredecessors().size());
+			if (block->ImmPredecessors().empty()) ready.push_back(block);
+			bool after_store = false;
+			for (const auto& inst: *block) {
+				if (after_store) return nullptr;
+				const auto op = inst.GetOpcode();
+				const auto buffer = BufferAccessOf(op);
+				const auto image = ImageOpcodeInfoOf(op).access;
+				if (buffer != BufferAccess::Write && buffer != BufferAccess::Atomic &&
+				    image != ImageAccess::Write && image != ImageAccess::Atomic &&
+				    AddressOpcodeInfoOf(op).access != AddressAccess::Write) continue;
+				if (store != nullptr || op != ValueOpcode::StoreBufferU32 ||
+				    !block->ImmSuccessors().empty() ||
+				    block->terminator.kind != CFG::TerminatorKind::Return) return nullptr;
