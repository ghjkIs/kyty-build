+				pending.push_back(inst->Arg(index));
+		}
+		return phis;
+	}
+
+	// V4 (#1224): shader writes may alias scalar memory (including on a later
+	// loop visit) but never user data. A branch condition that reads no memory
+	// cannot observe this shader's writes. Conservative: unknown => reads memory.
+	static bool ReadsMemory(Value value) {
+		std::vector<Value> pending {value};
+		std::set<const Inst*> visited;
+		while (!pending.empty()) {
+			const auto* inst = pending.back().Resolve().TryInstruction();
+			pending.pop_back();
+			if (inst == nullptr || !visited.insert(inst).second) continue;
+			if (visited.size() > 4096u) return true;
+			const auto op = inst->GetOpcode();
+			if (op == ValueOpcode::ReadConst || op == ValueOpcode::ReadConstBuffer ||
+			    AddressOpcodeInfoOf(op).access != AddressAccess::None ||
+			    BufferAccessOf(op) != BufferAccess::None ||
+			    ImageOpcodeInfoOf(op).access != ImageAccess::None) {
+				return true;
+			}
+			for (size_t index = 0; index < inst->NumArgs(); index++)
+				pending.push_back(inst->Arg(index));
+		}
+		return false;
+	}
+
+	// V3: a merged scalar buffer address may feed several BufferAtomic* sites
+	// (Ace Combat 8 CS 0x1d81bb2b74faf456: Phi -> BitwiseOr32 flag ->
+	// GetBufferResource -> 4x BufferAtomicOr32). Such a Phi qualifies for host
+	// Select lowering when it is a uniform diamond that is not inside a cycle and
+	// that no shader write can precede, so the host-evaluated descriptor reads
+	// observe the same memory as the GPU. Lane-dependent selection still fails.
+	void FindUniformAtomicDescriptorPhis() {
+		m_uniform_atomic_phis.clear();
+		std::set<const Inst*> rejected;
+		const auto write_free_prefix = [&](const Block* start) {
+			// Every block that can execute before 'start' (and 'start' itself).
+			std::vector<const Block*> pending {start};
+			std::set<const Block*> seen;
+			while (!pending.empty()) {
+				const auto* block = pending.back();
+				pending.pop_back();
+				if (!seen.insert(block).second) continue;
+				for (const auto& inst: *block)
+					if (WritesMemory(inst)) return false;
+				const auto preds = block->ImmPredecessors();
+				pending.insert(pending.end(), preds.begin(), preds.end());
+			}
+			return true;
+		};
+		for (const auto* block: m_program.blocks) {
+			for (const auto& inst: *block) {
+				if (inst.GetOpcode() != ValueOpcode::GetBufferResource) continue;
+				const bool atomic = std::ranges::any_of(inst.Uses(), [&](const Use& use) {
+					return use.user != nullptr && use.operand == 0u &&
+					       BufferAccessOf(use.user->GetOpcode()) == BufferAccess::Atomic;
+				});
+				if (!atomic) continue;
+				for (uint32_t word = 0; word < inst.NumArgs(); ++word) {
+				// V4 (#1224): any simple uniform expression over the Phi, not only Phi | imm.
+				for (const auto* phi: DescriptorWordPhis(inst.Arg(word))) {
+					if (m_uniform_atomic_phis.contains(phi) || rejected.contains(phi))
+						continue;
+					const Block* branch = nullptr;
+					std::array<const Block*, 2> targets {};
+					bool ok = UniformDescriptorDiamond(*phi, branch, targets);
+					const auto* merge = phi->Parent();
+					// Loops: the diamond must not be re-entered from its merge.
+					ok = ok && !Reaches(merge, branch);
+					// No write may execute before either incoming value is produced.
+					ok = ok && write_free_prefix(phi->PhiBlock(0)) &&
+					     write_free_prefix(phi->PhiBlock(1));
+					if (ok) m_uniform_atomic_phis.insert(phi);
+					else rejected.insert(phi);
+				}
+				}
+			}
+		}
+	}
+
+	Value LowerDescriptorPhi(Value value, bool terminal_store = false) {
+		value           = value.Resolve();
+		const auto* phi = value.TryInstruction();
+		if (phi == nullptr || phi->GetOpcode() != ValueOpcode::Phi ||
+		    phi->NumArgs() != 2u || phi->NumPhiBlocks() != 2u || phi->GetType() != Type::U32) {
 			return value;
 		}
+		const Block* branch = nullptr;
+		std::array<const Block*, 2> targets {};
+		if (!UniformDescriptorDiamond(*phi, branch, targets)) {
+			return value;
+		}
+		// With shader writes, a host-evaluated selection is accepted when:
+		//  - V2: the descriptor feeds the sole terminal store, or
+		//  - V3: the Phi is a proven uniform, write-free, acyclic atomic diamond, or
+		//  - V4 (#1224): the branch condition reads no memory (user data and
+		//    constants only), so no shader write can change which arm is taken.
+		//    Diamonds inside a cycle are still rejected on this path.
+		if (m_shader_writes && !terminal_store && !m_uniform_atomic_phis.contains(phi) &&
+		    (ReadsMemory(branch->condition) || Reaches(phi->Parent(), branch))) {
