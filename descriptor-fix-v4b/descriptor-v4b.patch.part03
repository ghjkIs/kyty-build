+	// V4 (#1224): lowers descriptor Phis nested in a uniform expression (S_BITSET1,
+	// shifts, adds, ... on a V# word selected by a scalar branch) by rebuilding the
+	// expression over the host selections in value_storage. GPU SSA is untouched.
+	Value LowerDescriptorWord(Value value, std::vector<std::pair<const Inst*, Value>>& lowered,
+	                          bool terminal_store, uint32_t depth = 0) {
+		value            = value.Resolve();
+		const auto* inst = value.TryInstruction();
+		if (inst == nullptr) {
+			return value;
+		}
+		if (inst->GetOpcode() == ValueOpcode::Phi) {
+			return LowerDescriptorPhi(value, terminal_store);
+		}
+		if (depth > 64u || !IsRuntimeUniformOp(inst->GetOpcode())) {
+			return value;
