 namespace Libs::Graphics {
 
@@ -20,15 +24,31 @@ namespace {
 constexpr size_t MaxPageFaults    = 1024;
 constexpr size_t PageFaultAreaSize = MaxPageFaults * sizeof(uint64_t);
 
+// Layer B: must match -DMAX_PAGE_FAULTS of bda_write_process (CMakeLists.txt).
+constexpr size_t   MaxBdaWrittenPages = 65536;
+constexpr uint64_t FaultBitmapBytes   = BufferCache::CACHING_NUMPAGES / 8;
+constexpr uint64_t BdaTailBytes = ShaderRecompiler::IR::BdaFaultLayout::TailWords * sizeof(uint32_t);
+constexpr uint64_t BdaDownloadTail    = MaxBdaWrittenPages * sizeof(uint64_t);
+constexpr uint64_t BdaDownloadSize    = BdaDownloadTail + 256;
+static_assert(FaultBitmapBytes % 256 == 0);
+
+uint64_t FaultBufferSize() {
+	return ShaderRecompiler::IR::BdaWritesEnabled() ? 2 * FaultBitmapBytes + BdaTailBytes
+	                                                : FaultBitmapBytes;
+}
+
 } // namespace
 
 FaultManager::FaultManager(GraphicContext& graphics, CommandScheduler& scheduler,
                            BufferCache& buffer_cache)
     : m_graphics(graphics), m_scheduler(scheduler), m_buffer_cache(buffer_cache),
       m_fault_buffer(graphics, scheduler, MemoryUsage::DeviceLocal, 0, AllFlags,
-                     BufferCache::CACHING_NUMPAGES / 8),
+                     FaultBufferSize()),
       m_download_buffer(graphics, scheduler, MemoryUsage::Download, 0, AllFlags,
-                        MaxPendingFaults * PageFaultAreaSize) {
+                        MaxPendingFaults * PageFaultAreaSize),
+      m_bda_writes(ShaderRecompiler::IR::BdaWritesEnabled()),
+      m_bda_download_buffer(graphics, scheduler, MemoryUsage::Download, 0, AllFlags,
+                            m_bda_writes ? BdaDownloadSize : 256) {
 	SetVulkanObjectNameF(m_graphics.device, m_fault_buffer.Handle(), "Fault Buffer");
 
 	const vk::DescriptorSetLayoutBinding bindings[] {
@@ -66,9 +86,29 @@ FaultManager::FaultManager(GraphicContext& graphics, CommandScheduler& scheduler
 	m_graphics.device.destroyShaderModule(module, nullptr);
 	RequireVulkanSuccess(result, "create fault-buffer pipeline");
 	SetVulkanObjectNameF(m_graphics.device, m_fault_process_pipeline, "Fault Buffer Parser");
+
+	if (m_bda_writes) {
+		const auto bda_module = CompileSPV(BDA_WRITE_PROCESS_SPV, m_graphics.device);
+		pipeline_info.stage.module = bda_module;
+		const auto bda_result = m_graphics.device.createComputePipelines(
+		    nullptr, 1, &pipeline_info, nullptr, &m_bda_settle_pipeline);
+		m_graphics.device.destroyShaderModule(bda_module, nullptr);
+		RequireVulkanSuccess(bda_result, "create BDA written-page pipeline");
+		SetVulkanObjectNameF(m_graphics.device, m_bda_settle_pipeline, "BDA Written Page Parser");
+		Log::WriteToConsoleAndLog(
+		    fmt::format("GPU: V4B BDA writes enabled (KYTY_BDA_WRITES{}): compute stores/atomics "
+		                "through GPU-computed V#s write through BDA and are settled after each "
+		                "dispatch; store log {}\n",
+		                ShaderRecompiler::IR::BdaWritesVerify() ? "=verify" : "=1",
+		                ShaderRecompiler::IR::BdaStoreLogEnabled() ? "on" : "off")
+		        .c_str());
+	}
 }
 
 FaultManager::~FaultManager() {
+	if (m_bda_settle_pipeline) {
+		m_graphics.device.destroyPipeline(m_bda_settle_pipeline, nullptr);
+	}
 	m_graphics.device.destroyPipeline(m_fault_process_pipeline, nullptr);
 	m_graphics.device.destroyPipelineLayout(m_fault_process_pipeline_layout, nullptr);
 	m_graphics.device.destroyDescriptorSetLayout(m_fault_process_desc_layout, nullptr);
@@ -149,4 +189,140 @@ void FaultManager::ProcessFaultBuffer() {
 	m_current_area %= MaxPendingFaults;
 }
 
+void FaultManager::PrepareBdaWrites() {
+	EXIT_IF(!m_bda_writes);
+	if (m_bda_cleared) {
+		return;
+	}
+	// Device-local memory starts undefined: clear the written-page bitmap and the tail once.
+	m_scheduler.EndRendering();
+	auto command = m_scheduler.Current().Handle();
+	command.fillBuffer(m_fault_buffer.Handle(), FaultBitmapBytes, FaultBitmapBytes + BdaTailBytes, 0);
+	vk::BufferMemoryBarrier barrier {};
+	barrier.srcAccessMask       = vk::AccessFlagBits::eTransferWrite;
+	barrier.dstAccessMask       = vk::AccessFlagBits::eShaderRead | vk::AccessFlagBits::eShaderWrite;
+	barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+	barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+	barrier.buffer              = m_fault_buffer.Handle();
+	barrier.offset              = FaultBitmapBytes;
+	barrier.size                = FaultBitmapBytes + BdaTailBytes;
+	command.pipelineBarrier(vk::PipelineStageFlagBits::eTransfer,
+	                        vk::PipelineStageFlagBits::eComputeShader, {}, 0, nullptr, 1, &barrier,
+	                        0, nullptr);
+	m_bda_cleared = true;
+}
+
+void FaultManager::SettleBdaWrites(uint64_t shader_hash) {
+	EXIT_IF(!m_bda_writes || !m_bda_cleared);
+	const bool store_log = ShaderRecompiler::IR::BdaStoreLogEnabled();
+	auto*      mapped    = m_bda_download_buffer.Mapped().data();
+	std::memset(mapped, 0, sizeof(uint64_t));
+	std::memset(mapped + BdaDownloadTail, 0, 2 * sizeof(uint32_t));
+	m_bda_download_buffer.Flush(0, sizeof(uint64_t));
+	m_bda_download_buffer.Flush(BdaDownloadTail, 2 * sizeof(uint32_t));
+
+	m_scheduler.EndRendering();
+	auto command = m_scheduler.Current().Handle();
+	vk::MemoryBarrier pre {};
+	pre.srcAccessMask = vk::AccessFlagBits::eShaderWrite | vk::AccessFlagBits::eHostWrite;
+	pre.dstAccessMask = vk::AccessFlagBits::eShaderRead | vk::AccessFlagBits::eShaderWrite |
+	                    vk::AccessFlagBits::eTransferRead | vk::AccessFlagBits::eTransferWrite;
+	command.pipelineBarrier(vk::PipelineStageFlagBits::eComputeShader | vk::PipelineStageFlagBits::eHost,
+	                        vk::PipelineStageFlagBits::eComputeShader |
+	                            vk::PipelineStageFlagBits::eTransfer,
+	                        {}, 1, &pre, 0, nullptr, 0, nullptr);
+	const vk::DescriptorBufferInfo infos[] {
+	    {m_fault_buffer.Handle(), FaultBitmapBytes, FaultBitmapBytes},
+	    {m_bda_download_buffer.Handle(), 0, BdaDownloadTail},
+	};
+	std::array<vk::WriteDescriptorSet, 2> writes {};
+	for (uint32_t index = 0; index < writes.size(); ++index) {
+		writes[index].dstBinding      = index;
+		writes[index].descriptorCount = 1;
+		writes[index].descriptorType  = vk::DescriptorType::eStorageBuffer;
+		writes[index].pBufferInfo     = &infos[index];
+	}
+	command.bindPipeline(vk::PipelineBindPoint::eCompute, m_bda_settle_pipeline);
+	command.pushDescriptorSetKHR(vk::PipelineBindPoint::eCompute, m_fault_process_pipeline_layout, 0,
+	                             writes);
+	const auto num_threads    = BufferCache::CACHING_NUMPAGES / 32;
+	const auto num_workgroups = (num_threads + 63) / 64;
+	command.dispatch(static_cast<uint32_t>(num_workgroups), 1, 1);
+	if (store_log) {
+		const vk::BufferCopy copy {2 * FaultBitmapBytes, BdaDownloadTail, 2 * sizeof(uint32_t)};
+		command.copyBuffer(m_fault_buffer.Handle(), m_bda_download_buffer.Handle(), 1, &copy);
+	}
+	vk::MemoryBarrier clear_barrier {};
+	clear_barrier.srcAccessMask = vk::AccessFlagBits::eTransferRead;
+	clear_barrier.dstAccessMask = vk::AccessFlagBits::eTransferWrite;
+	if (store_log) {
+		command.pipelineBarrier(vk::PipelineStageFlagBits::eTransfer,
+		                        vk::PipelineStageFlagBits::eTransfer, {}, 1, &clear_barrier, 0,
+		                        nullptr, 0, nullptr);
+		command.fillBuffer(m_fault_buffer.Handle(), 2 * FaultBitmapBytes, 2 * sizeof(uint32_t), 0);
+	}
+	vk::MemoryBarrier post {};
+	post.srcAccessMask = vk::AccessFlagBits::eShaderWrite | vk::AccessFlagBits::eTransferWrite;
+	post.dstAccessMask = vk::AccessFlagBits::eHostRead | vk::AccessFlagBits::eShaderRead |
+	                     vk::AccessFlagBits::eShaderWrite;
+	command.pipelineBarrier(vk::PipelineStageFlagBits::eComputeShader |
+	                            vk::PipelineStageFlagBits::eTransfer,
+	                        vk::PipelineStageFlagBits::eHost | vk::PipelineStageFlagBits::eAllCommands,
+	                        {}, 1, &post, 0, nullptr, 0, nullptr);
+
+	// Synchronous settle: the written pages must be GPU-dirty before anything (the CPU or the
+	// next dispatch's specialization reads) can look at them.
+	m_scheduler.Wait(m_scheduler.CurrentTick());
+	m_bda_download_buffer.Invalidate(0, BdaDownloadSize);
+
+	const auto* pages = std::bit_cast<const uint64_t*>(mapped);
+	const auto  found = static_cast<uint32_t>(pages[0]);
+	const auto  count = std::min<uint32_t>(found, MaxBdaWrittenPages - 1);
+	RangeSet    written;
+	for (uint32_t index = 1; index <= count; ++index) {
+		written.Add(BufferCache::GuestAddress(pages[index]), BufferCache::CACHING_PAGESIZE);
+	}
+	written.ForEach([this](uint64_t start, uint64_t end) {
+		m_buffer_cache.MarkBdaWritten(start, end - start);
+	});
+	m_bda_settles++;
+	m_bda_pages += count;
+
+	static std::unordered_set<uint64_t> logged;
+	const bool first = logged.insert(shader_hash).second;
+	if (first) {
+		Log::WriteToConsoleAndLog(
+		    fmt::format("GPU: V4B BdaSettle shader=0x{:016x} written_pages={} (settles={} pages={})\n",
+		                shader_hash, count, m_bda_settles, m_bda_pages)
+		        .c_str());
+	}
+	if (found >= MaxBdaWrittenPages) {
+		Log::WriteToConsoleAndLog(
+		    fmt::format("GPU: V4B BdaSettle overflow shader=0x{:016x}: {} written pages, only {} "
+		                "settled; later CPU reads of the rest may be stale\n",
+		                shader_hash, found, count)
+		        .c_str());
+		if (ShaderRecompiler::IR::BdaWritesVerify()) {
+			EXIT("BDA write settle overflow (KYTY_BDA_WRITES=verify)\n");
+		}
+	}
+	if (store_log) {
+		const auto* tail    = std::bit_cast<const uint32_t*>(mapped + BdaDownloadTail);
+		const auto  dropped = tail[ShaderRecompiler::IR::BdaFaultLayout::DroppedCountWord];
+		const auto  page    = tail[ShaderRecompiler::IR::BdaFaultLayout::DroppedPageWord];
+		if (dropped != 0) {
+			Log::WriteToConsoleAndLog(
+			    fmt::format("GPU: V4B BdaDroppedWrites shader=0x{:016x} count={} last_page=0x{:016x} "
+			                "(page had no cache buffer; it faults in for later dispatches)\n",
+			                shader_hash, dropped,
+			                page == 0 ? 0 : BufferCache::GuestAddress(uint64_t {page - 1}
+			                                                          << BufferCache::CACHING_PAGEBITS))
+			        .c_str());
+			if (ShaderRecompiler::IR::BdaWritesVerify()) {
+				EXIT("BDA writes dropped (KYTY_BDA_WRITES=verify)\n");
+			}
+		}
+	}
+}
+
 } // namespace Libs::Graphics
diff --git a/src/graphics/host_gpu/renderer/cache/faultManager.h b/src/graphics/host_gpu/renderer/cache/faultManager.h
index 86dde24..22cb032 100644
--- a/src/graphics/host_gpu/renderer/cache/faultManager.h
+++ b/src/graphics/host_gpu/renderer/cache/faultManager.h
@@ -21,6 +21,12 @@ public:
 
 	[[nodiscard]] Buffer* GetFaultBuffer() noexcept { return &m_fault_buffer; }
 	void                  ProcessFaultBuffer();
+	// Descriptor fix V4 Layer B (KYTY_BDA_WRITES): the fault buffer gains a written-page bitmap.
+	// PrepareBdaWrites runs before a BDA-writing dispatch; SettleBdaWrites runs right after it,
+	// waits for the GPU, and hands every written 16 KiB page to the buffer cache.
+	[[nodiscard]] bool    BdaWritesEnabled() const noexcept { return m_bda_writes; }
+	void                  PrepareBdaWrites();
+	void                  SettleBdaWrites(uint64_t shader_hash);
 
 private:
 	GraphicContext&                            m_graphics;
@@ -33,6 +39,12 @@ private:
 	vk::DescriptorSetLayout                    m_fault_process_desc_layout = nullptr;
 	vk::Pipeline                               m_fault_process_pipeline = nullptr;
 	vk::PipelineLayout                         m_fault_process_pipeline_layout = nullptr;
+	bool                                       m_bda_writes                    = false;
+	bool                                       m_bda_cleared                   = false;
+	Buffer                                     m_bda_download_buffer;
+	vk::Pipeline                               m_bda_settle_pipeline           = nullptr;
+	uint64_t                                   m_bda_settles                   = 0;
+	uint64_t                                   m_bda_pages                     = 0;
 };
 
 } // namespace Libs::Graphics
diff --git a/src/graphics/host_gpu/renderer/pipeline/descriptors.cpp b/src/graphics/host_gpu/renderer/pipeline/descriptors.cpp
index d5e8124..31f89de 100644
--- a/src/graphics/host_gpu/renderer/pipeline/descriptors.cpp
+++ b/src/graphics/host_gpu/renderer/pipeline/descriptors.cpp
@@ -25,6 +25,7 @@
 #include "graphics/host_gpu/renderer/render.h"
 #include "graphics/host_gpu/renderer/renderContext.h"
 #include "graphics/host_gpu/vulkanCommon.h"
+#include "graphics/shader/recompiler/ir/BdaWrites.h"
 #include "graphics/shader/recompiler/ir/ShaderIR.h"
 #include "graphics/shader/recompiler/ir/passes/ResourceMaterialization.h"
 #include "graphics/shader/shader.h"
@@ -35,7 +36,9 @@
 #include <bit>
 #include <fmt/format.h>
 #include <limits>
+#include <mutex>
 #include <span>
+#include <unordered_set>
 #include <vector>
 
 #ifdef min
@@ -51,6 +54,37 @@ namespace {
 
 using BindingKind = ShaderRecompiler::IR::DescriptorBindingKind;
 
+// Descriptor fix V4 Layer B. A compute dispatch is a single stage: the renderer captures its
+// scalar/SRT specialization reads from guest memory immediately before the dispatch (through
+// TryReadBufferBacking, which first pulls back GPU-dirty bytes), so the dispatch observes the
+// values its scalar loads had when it started. That is a valid outcome on hardware too, where
+// S_LOAD/S_BUFFER_LOAD go through the scalar cache, which is not coherent with the same
+// dispatch's vector stores. The overlapping buffer write is a bound, GPU-dirty-tracked write
+// (or a Layer B BDA write that is settled after the dispatch), so the NEXT dispatch reads the
+// written bytes again before it specializes. Ace Combat 8 CS 0xe41c5e833516362b updates its own
+// descriptor/state table with BUFFER_STORE at the end of the shader and hit this check.
+// Graphics pipelines (several stages, attachments) and image writes keep the upstream EXIT.
+bool AllowComputeSnapshotOverlap(const ShaderRecompiler::IR::CompiledShaderInfo& program,
+                                 size_t stage_count, uint64_t read_address, uint64_t read_size,
+                                 uint64_t write_address, uint64_t write_size, const char* site) {
+	if (stage_count != 1u || program.stage != ShaderType::Compute ||
+	    !ShaderRecompiler::IR::BdaWritesEnabled()) {
+		return false;
+	}
+	static std::mutex                   mutex;
+	static std::unordered_set<uint64_t> logged;
+	std::scoped_lock                    lock(mutex);
+	if (logged.insert(program.shader_hash).second) {
+		Log::WriteToConsoleAndLog(fmt::format(
+		    "descriptors: V4B allowing compute scalar-read/buffer-write overlap ({}): shader=0x{:016x} "
+		    "read=[0x{:x},+0x{:x}) write=[0x{:x},+0x{:x}) bda_writes={}; reads were captured before the "
+		    "dispatch and the write is GPU-dirty tracked (KYTY_BDA_WRITES=0 restores the EXIT)\n",
+		    site, program.shader_hash, read_address, read_size, write_address, write_size,
