+bool HazardCheckComputeReaders(vk::CommandBuffer vk_buffer, const ShaderStageRuntime& runtime,
+                               const char* consumer_kind, uint64_t extra_address,
+                               uint64_t extra_size) {
+	if (!runtime) {
+		return false;
+	}
+	auto& c = ComputeHazards();
+	if (c.sequence == 0) {
+		return false;
+	}
+	const auto& program   = *runtime.program;
+	const auto& resources = *runtime.resources;
+	std::vector<std::pair<uint64_t, uint64_t>> reads;
+	for (uint32_t i = 0; i < program.info.buffers.size() && i < resources.buffers.size(); i++) {
+		const auto d = DecodeHazardBuffer(resources.buffers[i]);
+		if (d.Base48() != 0 && d.NumRecords() != 0) {
+			reads.emplace_back(d.Base48(), d.Base48() + d.GetSize());
+		}
+	}
+	if (extra_address != 0 && extra_size != 0) {
+		reads.emplace_back(extra_address, extra_address + extra_size);
+	}
+	const bool reads_images = !program.info.images.empty();
+	const bool reads_bda    = program.info.uses_dma;
+	bool       hit          = false;
+	const uint64_t first = c.sequence > ComputeWriteWindow ? c.sequence - ComputeWriteWindow : 0;
+	for (uint64_t s = c.sequence; s > first; s--) {
+		const auto& w = c.ring[s % ComputeWriteWindow];
+		if (w.sequence != s || w.hash == program.shader_hash) {
+			continue;
+		}
+		const char* why   = nullptr;
+		uint64_t    r_lo  = 0;
+		uint64_t    r_hi  = 0;
+		uint64_t    w_lo  = 0;
+		uint64_t    w_hi  = 0;
+		for (const auto& r: reads) {
+			for (const auto& wr: w.ranges) {
+				if (r.first < wr.second && wr.first < r.second) {
+					why = "buffer range overlap";
+					r_lo = r.first; r_hi = r.second; w_lo = wr.first; w_hi = wr.second;
+					break;
+				}
+			}
+			if (why != nullptr) break;
+		}
+		if (why == nullptr && reads_bda && (w.bda || !w.ranges.empty())) {
+			why = w.bda ? "BDA reader after compute BDA write" : "BDA reader after compute buffer write";
+			if (!w.ranges.empty()) { w_lo = w.ranges[0].first; w_hi = w.ranges[0].second; }
+		}
+		if (why == nullptr && reads_images && w.image) {
+			why = "image reader after compute storage-image write";
+		}
+		if (why == nullptr) {
+			continue;
+		}
+		hit = true;
+		c.hits++;
+		const uint64_t pair = w.hash * 0x9e3779b97f4a7c15ull ^ program.shader_hash;
+		if (c.logged_pairs.size() < 256 && c.logged_pairs.insert(pair).second) {
+			const auto line = fmt::format(
+			    "[V15] compute hazard #{}: producer=0x{:016x} (dispatch -{}) -> {} consumer=0x{:016x} "
+			    "({}; read=[0x{:x},0x{:x}) write=[0x{:x},0x{:x}) writer_ranges={}{}{}; {})\n",
+			    c.hits, w.hash, c.sequence - s, consumer_kind, program.shader_hash, why, r_lo,
+			    r_hi, w_lo, w_hi, w.ranges.size(), w.image ? " +image" : "", w.bda ? " +bda" : "",
+			    HazardComputeBarrierEnabled() ? "extra global barrier emitted"
+			                                  : "ordered by the post-dispatch barrier");
+			std::printf("%s", line.c_str());
+			LOGF("%s", line.c_str());
