+// V15: EOP / RELEASE_MEM labels without an interrupt are written by the CPU while the packet is
+// parsed. On hardware the label lands only after every preceding draw/dispatch of the queue has
+// finished. Here the preceding work is at best recorded in the open command buffer, so a guest
+// CPU thread (or another guest queue's WAIT_REG_MEM) can observe "GPU done" while the GPU has not
+// even started it, and then reuse/overwrite/read memory that work still uses or produces.
+// KYTY_EOP_LABEL_SYNC=1 restores hardware order (submit + wait before the label is visible);
+// =2 only logs. Default 0 = V14 behaviour.
+void CommandProcessor::EopLabelPreWrite(const void* dst, uint64_t value, uint32_t bytes) {
+	const int mode = EopLabelSyncMode();
+	if (mode == 0) {
+		return;
+	}
+	static std::atomic<uint64_t> count {0};
+	const auto n = ++count;
+	if (n <= 64 || (n % 65536) == 0) {
+		const auto line = fmt::format(
+		    "[V15] EOP label #{} written at parse time: addr=0x{:016x} value=0x{:x} size={} queue={} "
+		    "submit={} -> {}\n",
+		    n, reinterpret_cast<uint64_t>(dst), value, bytes,
+		    IsAsyncComputeQueue() ? "compute" : "graphics", m_submit_id,
+		    mode == 1 ? "GPU finished first (KYTY_EOP_LABEL_SYNC=1)"
+		              : "log only, preceding GPU work may still be pending");
+		Log::WriteToConsoleAndLog(line);
+	}
+	if (mode == 1 && GetScheduler().Active()) {
+		SynchronizeGpu();
+	}
+}
