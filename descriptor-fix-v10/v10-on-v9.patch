+// V10 host-side null-write guard (KYTY_NULL_WRITE_GUARD, default on; "0"/"off"/"false" disables).
+static bool NullWriteGuardEnabled() {
+	static const bool enabled = [] {
+		const char* value = std::getenv("KYTY_NULL_WRITE_GUARD");
+		const bool  on    = value == nullptr ||
+		                !(std::strcmp(value, "0") == 0 || std::strcmp(value, "off") == 0 ||
+		                  std::strcmp(value, "OFF") == 0 || std::strcmp(value, "false") == 0);
+		LOGF("[V10] null-write guard %s (KYTY_NULL_WRITE_GUARD=%s)\n", on ? "ON" : "OFF",
+		     value != nullptr ? value : "<unset>");
+		return on;
+	}();
+	return enabled;
+}
+
+static std::atomic<uint64_t> g_null_write_substitutions {0};
+
+// Logs once per (shader hash, kind, slot); at most 256 distinct sites.
+static bool NullWriteGuardFirstSighting(uint64_t shader_hash, uint32_t kind, uint32_t slot) {
+	static std::mutex                   mutex;
+	static std::unordered_set<uint64_t> seen;
+	const uint64_t key = shader_hash ^ (uint64_t {kind} << 56u) ^ (uint64_t {slot} << 40u) ^
+	                     (uint64_t {slot} * 0x9e3779b97f4a7c15ull);
+	std::lock_guard lock(mutex);
+	if (seen.size() >= 256) return false;
+	return seen.insert(key).second;
+}
