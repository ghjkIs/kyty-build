+// Models the uploaded shader's diamond, merged base address, and stride flag.
+ResourcePlan TerminalStorePlan(unsigned rejected_case = 0) {
+  namespace CFG = Libs::Graphics::ShaderRecompiler::CFG;
+  Fixture f;
+  auto* entry = f.block;
+  auto* left = f.AddBlock();
+  auto* right = f.AddBlock();
+  auto* merge = f.AddBlock();
+  entry->AddBranch(left); entry->AddBranch(right);
+  left->AddBranch(merge); right->AddBranch(merge);
+  entry->terminator = {.kind=CFG::TerminatorKind::ConditionalBranch,
+                      .true_block=left, .false_block=right};
+  left->terminator = {.kind=CFG::TerminatorKind::Branch, .true_block=merge};
+  right->terminator = {.kind=CFG::TerminatorKind::Branch, .true_block=merge};
+  entry->condition = rejected_case == 1 ? f.Emit(ValueOpcode::ULessThan32,
+      {f.Emit(ValueOpcode::LaneId), Value(1u)}) :
+      f.Emit(ValueOpcode::INotEqual32, {f.UserData(0), Value(0u)});
+  auto address = f.Address(Value(0x1000u), Value(0u));
+  auto read = [&](Block* block, uint32_t offset) {
+    MemoryInfo m; m.kind=ResourceKind::ScalarAddress; m.offset=offset;
+    return f.Emit(ValueOpcode::LoadAddressU32,
+        {address, Value(0u), Value(0u), Value(true)}, f.AddMemory(m, 0x10+offset), block);
+  };
+  auto lo0=read(left,0), hi0=read(left,4);
+  auto lo1=read(right,8), hi1=read(right,12);
+  auto& lo=merge->AppendNewInst(ValueOpcode::Phi, {}, uint64_t(Type::U32));
+  lo.AddPhiOperand(left,lo0); lo.AddPhiOperand(right,lo1);
+  auto& hi=merge->AppendNewInst(ValueOpcode::Phi, {}, uint64_t(Type::U32));
+  hi.AddPhiOperand(left,hi0); hi.AddPhiOperand(right,hi1);
+  auto high=f.Emit(ValueOpcode::BitwiseOr32,{Value(&hi),Value(0x40000u)},0,merge);
+  auto handle=f.Emit(ValueOpcode::GetBufferResource,
+      {Value(&lo),high,Value(100u),Value(0x16204u)},MemoryFlags{0,0x84},merge);
+  MemoryInfo m; m.kind=ResourceKind::Buffer;
+  if (rejected_case == 2) {
+    auto prior=f.Buffer({Value(0x2000u),Value(0x40000u),Value(100u),Value(0x16204u)});
+    f.Emit(ValueOpcode::StoreBufferU32,
+        {prior,Value(0u),Value(0u),Value(0u),Value(0u),Value(true)},f.AddMemory(m,4),entry);
+  }
+  f.Emit(ValueOpcode::StoreBufferU32,
+      {handle,Value(4u),Value(0u),Value(0u),Value(0u),Value(true)},f.AddMemory(m,0x84),merge);
+  if (rejected_case == 3) {
+    merge->AddBranch(entry);
+    merge->terminator={.kind=CFG::TerminatorKind::Branch,.true_block=entry};
+  }
+  if (rejected_case == 4) read(merge,16);
+  f.PlanAndTrack();
+  Check(lo.GetOpcode()==ValueOpcode::Phi && hi.GetOpcode()==ValueOpcode::Phi &&
+        high.Instruction()->Arg(0).Instruction()==&hi,
+        "terminal store planning changed GPU SSA");
+  Check(f.program.info.buffers.size()==1 && f.program.info.buffers[0].written,
+        "terminal store lost its writable buffer binding");
+  EliminateDeadCode(f.program.blocks);
+  ValidateProgram(f.program,true);
+  return ExtractResourcePlan(f.program);
+}
+
+void TestTerminalStoreDescriptorPhi() {
+  auto plan=TerminalStorePlan();
+  TestMemory memory; memory.words={0x3000u,1u,0x4000u,2u};
+  for (uint32_t flag : {0u,1u}) {
+    std::array<uint32_t,64> user{}; user[0]=flag;
+    SrtRuntime runtime{.user_data=user,.read_memory=ReadTestMemory,.userdata=&memory,
+                       .read_specialization_memory=ReadTestMemory};
+    DescriptorValue value;
+    SrtWalker clean(plan,CleanRuntime(runtime));
+    Check(SrtWalker(plan,runtime,&clean).EvaluateDescriptor(plan.info.buffers[0].source,value),
+          "terminal store descriptor evaluation failed");
+    Check(value.dwords[0]==(flag ? 0x3000u:0x4000u) &&
+          value.dwords[1]==((flag ? 1u:2u)|0x40000u),
+          "terminal store selected wrong base or lost stride flag");
+  }
+  for (unsigned mode : {1u,2u,3u,4u})
+    CheckFatal([&]{TerminalStorePlan(mode);},"not a valid runtime value",
+               "unsafe writable descriptor selection accepted");
+}
+
+// V3: Ace Combat 8 CS 0x1d81bb2b74faf456 merges a scalar buffer address in a
+// uniform diamond, ORs a flag into the high word, and feeds several
+// BufferAtomicOr32 sites (plus unrelated stores) from the same Phi.
+ResourcePlan UniformAtomicPlan(unsigned rejected_case = 0,
+                               ValueOpcode atomic_op = ValueOpcode::BufferAtomicOr32) {
+  namespace CFG = Libs::Graphics::ShaderRecompiler::CFG;
+  Fixture f;
+  auto* entry = f.block;
+  auto* left = f.AddBlock();
+  auto* right = f.AddBlock();
+  auto* merge = f.AddBlock();
+  auto* tail = f.AddBlock();
+  entry->AddBranch(left); entry->AddBranch(right);
+  left->AddBranch(merge); right->AddBranch(merge);
+  merge->AddBranch(tail);
+  entry->terminator = {.kind=CFG::TerminatorKind::ConditionalBranch,
+                      .true_block=left, .false_block=right};
+  left->terminator = {.kind=CFG::TerminatorKind::Branch, .true_block=merge};
+  right->terminator = {.kind=CFG::TerminatorKind::Branch, .true_block=merge};
+  merge->terminator = {.kind=CFG::TerminatorKind::Branch, .true_block=tail};
+  if (rejected_case == 4) {
+    // Write-free loop around the diamond; all writes happen after the loop exits.
+    merge->AddBranch(entry);
+    merge->terminator = {.kind=CFG::TerminatorKind::ConditionalBranch,
+                        .true_block=tail, .false_block=entry};
+    merge->condition = f.Emit(ValueOpcode::INotEqual32, {f.UserData(1), Value(0u)});
+  }
+  entry->condition = rejected_case == 1 ? f.Emit(ValueOpcode::ULessThan32,
+      {f.Emit(ValueOpcode::LaneId), Value(1u)}) :
+      f.Emit(ValueOpcode::INotEqual32, {f.UserData(0), Value(0u)});
+  auto address = f.Address(Value(0x1000u), Value(0u));
+  auto read = [&](Block* block, uint32_t offset) {
+    MemoryInfo m; m.kind=ResourceKind::ScalarAddress; m.offset=offset;
+    return f.Emit(ValueOpcode::LoadAddressU32,
+        {address, Value(0u), Value(0u), Value(true)}, f.AddMemory(m, 0x10+offset), block);
+  };
+  auto lo0=read(left,0), hi0=read(left,4);
+  auto lo1=read(right,8), hi1=read(right,12);
+  auto& lo=merge->AppendNewInst(ValueOpcode::Phi, {}, uint64_t(Type::U32));
+  lo.AddPhiOperand(left,lo0); lo.AddPhiOperand(right,lo1);
+  auto& hi=merge->AppendNewInst(ValueOpcode::Phi, {}, uint64_t(Type::U32));
+  hi.AddPhiOperand(left,hi0); hi.AddPhiOperand(right,hi1);
+  auto high=f.Emit(ValueOpcode::BitwiseOr32,{Value(&hi),Value(0x40000u)},0,merge);
+  MemoryInfo m; m.kind=ResourceKind::Buffer;
+  if (rejected_case == 2) {
+    // A write before the descriptor reads could alias them; host values would be stale.
+    auto prior=f.Buffer({Value(0x2000u),Value(0x40000u),Value(100u),Value(0x16204u)});
+    f.Emit(ValueOpcode::StoreBufferU32,
+        {prior,Value(0u),Value(0u),Value(0u),Value(0u),Value(true)},f.AddMemory(m,4),entry);
+  }
+  // Unrelated straight-line store between the atomics: V2's sole-terminal-store
+  // rule rejects this shape, V3 must not.
+  auto other=f.Buffer({f.UserData(6),Value(0x400000u),Value(100u),Value(0x10016204u)});
+  f.Emit(ValueOpcode::StoreBufferU32,
+      {other,Value(0u),Value(0u),Value(0u),Value(5u),Value(true)},f.AddMemory(m,0x90),
+      rejected_case == 4 ? tail : merge);
+  std::vector<Value> handles;
+  for (uint32_t site = 0; site < 2u; ++site) {
+    auto* block = site == 0 && rejected_case != 4 ? merge : tail;
+    const uint32_t pc = 0x1a0u + site * 0xc0u;
+    auto handle=f.Emit(ValueOpcode::GetBufferResource,
+        {Value(&lo),high,Value(100u),Value(0x16204u)},MemoryFlags{0,pc},block);
+    // Result unused, as in the shader; the atomic itself is a side effect.
+    f.Emit(atomic_op,
+        {handle,Value(1u),Value(0u),Value(0u),Value(0u),Value(true)},f.AddMemory(m,pc),block);
+    handles.push_back(handle);
+  }
+  if (rejected_case == 3) {
+    tail->AddBranch(entry);
+    tail->terminator={.kind=CFG::TerminatorKind::Branch,.true_block=entry};
+  }
+  f.PlanAndTrack();
+  Check(lo.GetOpcode()==ValueOpcode::Phi && hi.GetOpcode()==ValueOpcode::Phi &&
+        high.Instruction()->Arg(0).Instruction()==&hi &&
+        handles[0].Instruction()->Arg(0).Instruction()==&lo &&
+        handles[1].Instruction()->Arg(0).Instruction()==&lo,
+        "uniform atomic planning changed GPU SSA");
+  Check(f.program.info.buffers.size()==2,
+        "uniform atomic descriptor was not shared by both atomic sites");
+  Check(handles[0].Instruction()->Flags<uint32_t>()==handles[1].Instruction()->Flags<uint32_t>(),
+        "atomic sites using the same Phi were bound to different buffers");
+  const auto& atomic_buffer=f.program.info.buffers[handles[0].Instruction()->Flags<uint32_t>()];
+  Check(atomic_buffer.written && atomic_buffer.atomic && atomic_buffer.read,
+        "uniform atomic descriptor lost its writable/atomic buffer binding");
+  for (const auto& memory : f.program.memory_info)
+    Check(memory.kind!=ResourceKind::IndirectBuffer,
+          "uniform atomic descriptor fell back to an indirect buffer");
+  EliminateDeadCode(f.program.blocks);
+  ValidateProgram(f.program,true);
+  return ExtractResourcePlan(f.program);
+}
+
+void TestUniformAtomicDescriptorPhi() {
+  for (const auto op : {ValueOpcode::BufferAtomicOr32, ValueOpcode::BufferAtomicIAdd32}) {
+    auto plan=UniformAtomicPlan(0, op);
+    TestMemory memory; memory.words={0x3000u,1u,0x4000u,2u};
+    const auto atomic_index = plan.info.buffers[0].atomic ? 0u : 1u;
+    for (uint32_t flag : {0u,1u}) {
+      std::array<uint32_t,64> user{}; user[0]=flag; user[6]=0x9000u;
+      SrtRuntime runtime{.user_data=user,.read_memory=ReadTestMemory,.userdata=&memory,
+                         .read_specialization_memory=ReadTestMemory};
+      DescriptorValue value;
+      SrtWalker clean(plan,CleanRuntime(runtime));
+      Check(SrtWalker(plan,runtime,&clean).EvaluateDescriptor(
+                plan.info.buffers[atomic_index].source,value),
+            "uniform atomic descriptor evaluation failed");
+      Check(value.dwords[0]==(flag ? 0x3000u:0x4000u) &&
+            value.dwords[1]==((flag ? 1u:2u)|0x40000u),
+            "uniform atomic descriptor selected wrong base or lost flag");
+    }
+  }
+  for (unsigned mode : {1u,2u,3u,4u})
+    CheckFatal([&]{UniformAtomicPlan(mode);},"not a valid runtime value",
+               "unsafe atomic descriptor selection accepted");
+  CheckFatal([&]{UniformAtomicPlan(1u);},"opcode=BufferAtomicOr32",
+             "lane-dependent atomic descriptor lost its opcode diagnostic");
+}
