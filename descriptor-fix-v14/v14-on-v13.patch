+void HazardNoteGraphicsStageWrites(const ShaderStageRuntime& runtime, bool include_buffers) {
+	if (!runtime) {
+		return;
+	}
+	const auto& program   = *runtime.program;
+	const auto& resources = *runtime.resources;
+	auto&       h         = Hazards();
+	bool        wrote     = false;
+	for (uint32_t i = 0; include_buffers && i < program.info.buffers.size() &&
+	                     i < resources.buffers.size(); i++) {
+		if (!program.info.buffers[i].written) {
+			continue;
+		}
+		const auto d = DecodeHazardBuffer(resources.buffers[i]);
+		if (d.Base48() != 0 && d.NumRecords() != 0) {
+			HazardAddRange(d.Base48(), d.GetSize());
+			wrote = true;
+		}
+	}
+	for (const auto& image: program.info.images) {
+		if (image.written &&
+		    image.resource_class == ShaderRecompiler::IR::ImageResourceClass::Storage) {
+			h.image_write = true;
+			wrote         = true;
+		}
+	}
+	if (program.info.bda_writes) {
+		h.unknown_write = true;
+		wrote           = true;
+	}
+	if (wrote) {
+		h.producer_hash = program.shader_hash;
+	}
+}
