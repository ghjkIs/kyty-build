+bool HazardPending() {
+	const auto& h = Hazards();
+	return h.unknown_write || h.image_write || !h.ranges.empty();
+}
+
+bool HazardRangeConflicts(uint64_t address, uint64_t size) {
+	auto& h = Hazards();
+	if (!HazardPending()) {
+		return false;
+	}
+	if (h.unknown_write) {
+		h.reason         = "pending graphics BDA/overflow write";
+		h.reason_address = address;
+		return true;
+	}
+	const uint64_t end = address + (size == 0 ? 1 : size);
+	for (const auto& r: h.ranges) {
+		if (address < r.second && r.first < end) {
+			h.reason         = "range overlap";
+			h.reason_address = address;
+			return true;
+		}
+	}
+	return false;
+}
+
+bool HazardStageConflicts(const ShaderStageRuntime& runtime) {
+	auto& h = Hazards();
+	if (!runtime || !HazardPending()) {
+		return false;
+	}
+	const auto& program   = *runtime.program;
+	const auto& resources = *runtime.resources;
+	if (h.unknown_write) {
+		h.reason         = "pending graphics BDA/overflow write";
+		h.reason_address = 0;
+		return true;
+	}
+	if (program.info.uses_dma) {
+		// BDA readers can touch any guest page.
+		h.reason         = "BDA reader after pending graphics write";
+		h.reason_address = 0;
+		return true;
+	}
+	if (h.image_write && !program.info.images.empty()) {
+		h.reason         = "image reader after graphics storage-image write";
+		h.reason_address = 0;
+		return true;
+	}
+	for (uint32_t i = 0; i < program.info.buffers.size() && i < resources.buffers.size(); i++) {
+		const auto d = DecodeHazardBuffer(resources.buffers[i]);
+		if (d.Base48() != 0 && d.NumRecords() != 0 &&
+		    HazardRangeConflicts(d.Base48(), d.GetSize())) {
+			return true;
+		}
+	}
+	return false;
+}
+
+void HazardReset() {
+	auto& h = Hazards();
+	h.ranges.clear();
+	h.unknown_write = false;
+	h.image_write   = false;
+	h.producer_hash = 0;
+}
+
+void HazardBarrier(vk::CommandBuffer vk_buffer, const char* consumer_kind, uint64_t consumer_hash) {
+	EXIT_IF(vk_buffer == nullptr);
+	auto&             h = Hazards();
+	vk::MemoryBarrier barrier {};
+	barrier.srcAccessMask = vk::AccessFlagBits::eMemoryWrite;
+	barrier.dstAccessMask = vk::AccessFlagBits::eMemoryRead | vk::AccessFlagBits::eMemoryWrite;
+	vk_buffer.pipelineBarrier(vk::PipelineStageFlagBits::eAllCommands,
+	                          vk::PipelineStageFlagBits::eAllCommands, vk::DependencyFlags {}, 1,
+	                          &barrier, 0, nullptr, 0, nullptr);
+	const auto count = ++h.barriers;
+	if (count <= 64 || (count % 4096) == 0) {
+		std::printf("[V14] hazard barrier #%" PRIu64 ": producer=0x%016" PRIx64
+		            " -> %s consumer=0x%016" PRIx64 " (%s, addr=0x%012" PRIx64 ")\n",
+		            count, h.producer_hash, consumer_kind, consumer_hash, h.reason,
+		            h.reason_address);
+		LOGF("[V14] hazard barrier #%" PRIu64 ": producer=0x%016" PRIx64
+		     " -> %s consumer=0x%016" PRIx64 " (%s, addr=0x%012" PRIx64 ")\n",
+		     count, h.producer_hash, consumer_kind, consumer_hash, h.reason, h.reason_address);
+	}
+	HazardReset();
+}
+
 } // namespace Libs::Graphics
