+struct HazardState {
+	std::vector<std::pair<uint64_t, uint64_t>> ranges; // [begin, end) guest ranges
+	bool        unknown_write  = false;  // graphics BDA write / range overflow: any read conflicts
+	bool        image_write    = false;  // storage image written by a graphics stage
+	uint64_t    producer_hash  = 0;
+	const char* reason         = "";
+	uint64_t    reason_address = 0;
+	uint64_t    barriers       = 0;
+};
+
+HazardState& Hazards() {
+	static HazardState state;
+	return state;
+}
+
+constexpr size_t MaxHazardRanges = 128;
+
+void HazardAddRange(uint64_t begin, uint64_t size) {
+	auto& h = Hazards();
+	if (size == 0 || begin == 0) {
+		return;
+	}
+	const uint64_t end = begin + size;
+	for (auto& r: h.ranges) {
+		if (begin <= r.second && r.first <= end) {
+			r.first  = std::min(r.first, begin);
+			r.second = std::max(r.second, end);
+			return;
+		}
+	}
+	if (h.ranges.size() >= MaxHazardRanges) {
+		h.unknown_write = true; // overflow: be conservative
+		return;
+	}
+	h.ranges.emplace_back(begin, end);
+}
+
+ShaderBufferResource DecodeHazardBuffer(const ShaderRecompiler::IR::DescriptorValue& value) {
+	ShaderBufferResource descriptor;
+	EXIT_IF(value.dword_count < 4);
+	std::memcpy(descriptor.fields, value.dwords.data(), sizeof(descriptor.fields));
+	return descriptor;
+}
+
