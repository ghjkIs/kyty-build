+void CommandProcessor::DebugSyncBeforeDispatch() {
+	// V12 KYTY_SYNC_COMPUTE=2: order back-to-back dispatches.
+	if (DebugSyncComputeMode() == 2 && m_debug_sync_after_dispatch) {
+		EmitGlobalBarrier();
+	}
+	m_debug_sync_after_dispatch = false;
+}
+
+void CommandProcessor::DebugSyncAfterDispatch() {
+	const int mode = DebugSyncComputeMode();
+	if (mode == 1) {
+		EmitGlobalBarrier();
+	} else if (mode == 2) {
+		m_debug_sync_after_dispatch = true;
+	}
+}
+
+void CommandProcessor::DebugSyncBeforeDraw() {
