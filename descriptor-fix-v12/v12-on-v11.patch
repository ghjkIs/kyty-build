diff --git a/src/graphics/host_gpu/renderer/debugSync.h b/src/graphics/host_gpu/renderer/debugSync.h
new file mode 100644
index 0000000..148d9d3
--- /dev/null
+++ b/src/graphics/host_gpu/renderer/debugSync.h
@@ -0,0 +1,47 @@
+#ifndef EMULATOR_SRC_GRAPHICS_HOST_GPU_RENDERER_DEBUGSYNC_H_
+#define EMULATOR_SRC_GRAPHICS_HOST_GPU_RENDERER_DEBUGSYNC_H_
+
+// Descriptor fix V12: debug synchronization switches (default off). Read once per process.
+//
+// KYTY_SYNC_COMPUTE:
+//   unset / "0" - off (default)
+//   "1"         - full memory barrier (all commands, memory write -> memory read/write, which
+//                 includes indirect-command reads) after every compute dispatch and before every
+//                 draw
+//   "2"         - lighter: barrier only after a dispatch that is followed by another dispatch
+//                 or a draw (no draw->draw barriers)
+// KYTY_SYNC_SUBMIT=1: wait for every queue submit to complete (queue waitIdle) before continuing.
+// KYTY_ACQUIRE_MEM_BARRIER (default on): V12 maps guest ACQUIRE_MEM to a global barrier;
+//   "0" restores the pre-V12 no-op.
+
+#include <cstdlib>
+#include <cstring>
+
+namespace Libs::Graphics {
+
+inline int DebugSyncEnvInt(const char* name, int def) {
+	const char* v = std::getenv(name);
+	if (v == nullptr || v[0] == '\0') return def;
+	if (std::strcmp(v, "off") == 0 || std::strcmp(v, "false") == 0) return 0;
+	if (std::strcmp(v, "on") == 0 || std::strcmp(v, "true") == 0) return 1;
+	return std::atoi(v);
+}
+
+inline int DebugSyncComputeMode() {
+	static const int mode = DebugSyncEnvInt("KYTY_SYNC_COMPUTE", 0);
+	return mode;
+}
+
+inline bool DebugSyncSubmit() {
+	static const bool on = DebugSyncEnvInt("KYTY_SYNC_SUBMIT", 0) != 0;
+	return on;
+}
+
+inline bool AcquireMemBarrierEnabled() {
+	static const bool on = DebugSyncEnvInt("KYTY_ACQUIRE_MEM_BARRIER", 1) != 0;
+	return on;
+}
+
+} // namespace Libs::Graphics
+
+#endif // EMULATOR_SRC_GRAPHICS_HOST_GPU_RENDERER_DEBUGSYNC_H_
