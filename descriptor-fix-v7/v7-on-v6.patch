index 0000000..a0fe2c5
--- /dev/null
+++ b/src/graphics/host_gpu/diagnosticCheckpoints.cpp
@@ -0,0 +1,258 @@
+#include "graphics/host_gpu/vulkanCommon.h"
+
+#include "common/logging/log.h"
+#include "graphics/host_gpu/graphicContext.h"
+
+#include <array>
+#include <atomic>
+#include <cinttypes>
+#include <cstdio>
+#include <mutex>
+#include <vector>
+
+namespace Libs::Graphics {
+
+namespace {
+
+constexpr size_t CHECKPOINT_RING_SIZE = 1u << 16u;
+
+std::array<DiagnosticCheckpoint, CHECKPOINT_RING_SIZE> g_checkpoints {};
+std::atomic<uint64_t>                                  g_checkpoint_sequence {0};
+
+const char* OpName(uint32_t op) {
+	switch (op) {
+		case 0: return "DispatchDirect";
+		case 1: return "DrawIndex";
+		case 2: return "DrawIndexAuto";
+		case 3: return "EopWrite";
+		case 4: return "EopInterrupt";
+		case 5: return "EopWriteBack";
+		case 6: return "EopFlip";
+		case 7: return "EopWriteBackFlip";
+		case 8: return "EopOnlyFlip";
+		case 9: return "DispatchIndirect";
+		default: return "Unknown";
+	}
+}
+
+void Print(const char* stage, const DiagnosticCheckpoint& checkpoint) {
+	std::printf("  [%s] seq=%" PRIu64 " op=%s submit=%" PRIu64 " args=%u,%u,%u,%u,0x%016" PRIx64
+	            " hash=0x%016" PRIx64 "\n",
+	            stage, checkpoint.sequence, OpName(checkpoint.op), checkpoint.submit_id,
+	            checkpoint.arg0, checkpoint.arg1, checkpoint.arg2, checkpoint.arg3,
+	            checkpoint.arg4, checkpoint.shader_hash);
+	LOGF("  [%s] seq=%" PRIu64 " op=%s submit=%" PRIu64 " args=%u,%u,%u,%u,0x%016" PRIx64 " hash=0x%016" PRIx64 "\n",
+	     stage, checkpoint.sequence, OpName(checkpoint.op), checkpoint.submit_id, checkpoint.arg0,
+	     checkpoint.arg1, checkpoint.arg2, checkpoint.arg3, checkpoint.arg4,
+	     checkpoint.shader_hash);
+}
+
+constexpr size_t DISPATCH_RING_SIZE = 256;
+constexpr size_t BINDING_RING_SIZE  = 1u << 14u;
+
+struct BindingRecord {
+	uint64_t address  = 0;
+	uint64_t size     = 0;
+	uint64_t sequence = 0;
+	uint32_t type     = 0;
+	bool     bind     = false;
+};
+
+std::mutex                                       g_dispatch_mutex;
+std::array<DispatchRecord, DISPATCH_RING_SIZE>   g_dispatches {};
+uint64_t                                         g_dispatch_sequence = 0;
+std::mutex                                       g_binding_mutex;
+std::array<BindingRecord, BINDING_RING_SIZE>     g_bindings {};
+uint64_t                                         g_binding_sequence = 0;
+
+bool IsWatchedShader(uint64_t addr) {
+	// Recurring Ace Combat 8 prefs culprits live at 0x1640xxxxxx
+	// (e.g. 0x16401e1e00 args=192,108,1,65 and 0x1640211e00 args=189,106,1,65).
+	return (addr >> 24u) == 0x1640u;
+}
+
+void PrintDispatch(const char* tag, const DispatchRecord& r) {
+	std::printf("  [%s] seq=%" PRIu64 " %s submit=%" PRIu64 " shader=0x%010" PRIx64
+	            " hash=0x%016" PRIx64 " groups=%u,%u,%u mode=0x%x args=0x%012" PRIx64
+	            " bda=%u bda_writes=%u glc=%u\n",
+	            tag, r.sequence, r.indirect ? "DispatchIndirect" : "DispatchDirect", r.submit_id,
+	            r.shader_addr, r.shader_hash, r.groups_x, r.groups_y, r.groups_z, r.mode,
+	            r.indirect_args, r.uses_bda ? 1u : 0u, r.bda_writes ? 1u : 0u,
+	            r.coherent ? 1u : 0u);
+	LOGF("  [%s] seq=%" PRIu64 " %s submit=%" PRIu64 " shader=0x%010" PRIx64
+	     " hash=0x%016" PRIx64 " groups=%u,%u,%u mode=0x%x args=0x%012" PRIx64
+	     " bda=%u bda_writes=%u glc=%u\n",
+	     tag, r.sequence, r.indirect ? "DispatchIndirect" : "DispatchDirect", r.submit_id,
+	     r.shader_addr, r.shader_hash, r.groups_x, r.groups_y, r.groups_z, r.mode, r.indirect_args,
+	     r.uses_bda ? 1u : 0u, r.bda_writes ? 1u : 0u, r.coherent ? 1u : 0u);
+}
+
+void MatchFaultAddress(uint64_t va, uint64_t precision) {
+	const uint64_t mask = precision > 1 ? ~(precision - 1) : ~uint64_t {0};
+	std::lock_guard<std::mutex>       lock(g_binding_mutex);
+	const uint64_t    total = g_binding_sequence;
+	const uint64_t    first = total > BINDING_RING_SIZE ? total - BINDING_RING_SIZE : 0;
+	uint32_t          hits  = 0;
+	for (uint64_t s = total; s > first && hits < 16; s--) {
+		const auto& b = g_bindings[(s - 1) % BINDING_RING_SIZE];
+		const uint64_t lo = b.address & mask;
+		const uint64_t hi = b.address + b.size;
+		if ((va & mask) >= lo && va < hi + (precision > 1 ? precision : 0)) {
+			std::printf("    fault VA 0x%016" PRIx64 " in %s seq=%" PRIu64 " [0x%016" PRIx64
+			            ", +0x%" PRIx64 ") type=%u\n",
+			            va, b.bind ? "BIND" : "UNBIND", b.sequence, b.address, b.size, b.type);
+			LOGF("    fault VA 0x%016" PRIx64 " in %s seq=%" PRIu64 " [0x%016" PRIx64
+			     ", +0x%" PRIx64 ") type=%u\n",
+			     va, b.bind ? "BIND" : "UNBIND", b.sequence, b.address, b.size, b.type);
+			hits++;
+		}
+	}
+	if (hits == 0) {
+		std::printf("    fault VA 0x%016" PRIx64 " matches no recorded bind/unbind (%" PRIu64
+		            " recorded)\n", va, total);
+		LOGF("    fault VA 0x%016" PRIx64 " matches no recorded bind/unbind (%" PRIu64
+		     " recorded)\n", va, total);
+	}
+}
+
+void DumpDispatchRing() {
+	std::lock_guard<std::mutex>       lock(g_dispatch_mutex);
+	const uint64_t    total = g_dispatch_sequence;
+	const uint64_t    first = total > DISPATCH_RING_SIZE ? total - DISPATCH_RING_SIZE : 0;
+	std::printf("--- Last %" PRIu64 " compute dispatches (of %" PRIu64 ") ---\n", total - first,
+	            total);
+	LOGF("--- Last %" PRIu64 " compute dispatches (of %" PRIu64 ") ---\n", total - first, total);
+	for (uint64_t s = first; s < total; s++) {
+		PrintDispatch("ring", g_dispatches[s % DISPATCH_RING_SIZE]);
+	}
+}
+
+}
+
+void RecordDispatch(const DispatchRecord& record) {
+	DispatchRecord copy = record;
+	{
+		std::lock_guard<std::mutex>       lock(g_dispatch_mutex);
+		copy.sequence = ++g_dispatch_sequence;
+		g_dispatches[copy.sequence % DISPATCH_RING_SIZE] = copy;
+	}
+	if (IsWatchedShader(copy.shader_addr)) {
+		PrintDispatch("watch-0x1640", copy);
+	}
+}
+
+void RecordAddressBinding(uint64_t address, uint64_t size, bool bind, uint32_t type) {
+	std::lock_guard<std::mutex>       lock(g_binding_mutex);
+	auto&             slot = g_bindings[g_binding_sequence % BINDING_RING_SIZE];
+	slot.address           = address;
+	slot.size              = size;
+	slot.bind              = bind;
+	slot.type              = type;
+	slot.sequence          = ++g_binding_sequence;
+}
+
+const DiagnosticCheckpoint* RecordDiagnosticCheckpoint(const DiagnosticCheckpoint& checkpoint) {
+	const auto sequence = g_checkpoint_sequence.fetch_add(1, std::memory_order_relaxed) + 1;
+	auto&      slot     = g_checkpoints[sequence % CHECKPOINT_RING_SIZE];
+	slot                = checkpoint;
+	slot.sequence       = sequence;
+	return &slot;
+}
+
+static void DumpDeviceFault(GraphicContext& graphics) {
+	if (!graphics.device_fault_enabled) {
+		return;
+	}
+	vk::DeviceFaultCountsEXT counts {};
+	auto result = graphics.device.getFaultInfoEXT(&counts, nullptr);
+	if (result != vk::Result::eSuccess && result != vk::Result::eIncomplete) {
+		std::printf("--- Device fault: query failed: %s ---\n", vk::to_string(result).c_str());
+		return;
+	}
+	std::vector<vk::DeviceFaultAddressInfoEXT> addresses(counts.addressInfoCount);
+	std::vector<vk::DeviceFaultVendorInfoEXT>  vendors(counts.vendorInfoCount);
+	std::vector<uint8_t>                       binary(static_cast<size_t>(counts.vendorBinarySize));
+	vk::DeviceFaultInfoEXT                     info {};
+	info.pAddressInfos = addresses.empty() ? nullptr : addresses.data();
+	info.pVendorInfos  = vendors.empty() ? nullptr : vendors.data();
+	info.pVendorBinaryData = binary.empty() ? nullptr : binary.data();
+	result = graphics.device.getFaultInfoEXT(&counts, &info);
+	std::printf("--- Device fault (%s): \"%s\" addresses=%u vendor=%u binary=%" PRIu64 " ---\n",
+	            vk::to_string(result).c_str(), info.description.data(), counts.addressInfoCount,
+	            counts.vendorInfoCount, static_cast<uint64_t>(counts.vendorBinarySize));
+	LOGF("--- Device fault (%s): \"%s\" addresses=%u vendor=%u binary=%" PRIu64 " ---\n",
+	     vk::to_string(result).c_str(), info.description.data(), counts.addressInfoCount,
+	     counts.vendorInfoCount, static_cast<uint64_t>(counts.vendorBinarySize));
+	if (!binary.empty()) {
+		if (auto* file = std::fopen("_device_fault.nv-gpudmp", "wb"); file != nullptr) {
+			std::fwrite(binary.data(), 1, binary.size(), file);
+			std::fclose(file);
+			std::printf("  vendor binary written to _device_fault.nv-gpudmp\n");
+		}
+	}
+	for (uint32_t i = 0; i < counts.addressInfoCount; i++) {
+		const auto& address = addresses[i];
+		std::printf("  address[%u]: %s at 0x%016" PRIx64 " (precision 0x%" PRIx64 ")\n", i,
+		            vk::to_string(address.addressType).c_str(),
+		            static_cast<uint64_t>(address.reportedAddress),
+		            static_cast<uint64_t>(address.addressPrecision));
+		LOGF("  address[%u]: %s at 0x%016" PRIx64 " (precision 0x%" PRIx64 ")\n", i,
+		     vk::to_string(address.addressType).c_str(),
+		     static_cast<uint64_t>(address.reportedAddress),
+		     static_cast<uint64_t>(address.addressPrecision));
+		if (graphics.address_binding_report_enabled) {
+			MatchFaultAddress(static_cast<uint64_t>(address.reportedAddress),
+			                  static_cast<uint64_t>(address.addressPrecision));
+		}
+	}
+	for (uint32_t i = 0; i < counts.vendorInfoCount; i++) {
+		const auto& vendor = vendors[i];
+		std::printf("  vendor[%u]: \"%s\" code=0x%016" PRIx64 " data=0x%016" PRIx64 "\n", i,
+		            vendor.description.data(), static_cast<uint64_t>(vendor.vendorFaultCode),
+		            static_cast<uint64_t>(vendor.vendorFaultData));
+		LOGF("  vendor[%u]: \"%s\" code=0x%016" PRIx64 " data=0x%016" PRIx64 "\n", i,
+		     vendor.description.data(), static_cast<uint64_t>(vendor.vendorFaultCode),
+		     static_cast<uint64_t>(vendor.vendorFaultData));
+	}
+	std::fflush(stdout);
+}
+
+void DumpDeviceLossDiagnostics(GraphicContext& graphics) {
+	static std::atomic<bool> dumped {false};
+	if (dumped.exchange(true)) {
+		return;
+	}
+	DumpDeviceFault(graphics);
+	DumpDispatchRing();
+	std::fflush(stdout);
+	if (!graphics.diagnostic_checkpoints_enabled || graphics.queue == nullptr) {
+		return;
+	}
+	std::vector<vk::CheckpointDataNV> data;
+	{
+		Common::LockGuard lock(graphics.queue_mutex);
+		data = graphics.queue.getCheckpointDataNV();
+	}
+	std::printf("--- Diagnostic checkpoints (%zu, last recorded seq=%" PRIu64 ") ---\n",
+	            data.size(), g_checkpoint_sequence.load(std::memory_order_relaxed));
+	LOGF("--- Diagnostic checkpoints (%zu, last recorded seq=%" PRIu64 ") ---\n", data.size(),
+	     g_checkpoint_sequence.load(std::memory_order_relaxed));
+	for (const auto& entry: data) {
+		const auto* checkpoint = static_cast<const DiagnosticCheckpoint*>(entry.pCheckpointMarker);
+		const auto  stage      = vk::to_string(entry.stage);
+		const bool  in_ring    = checkpoint >= g_checkpoints.data() &&
+		                      checkpoint < g_checkpoints.data() + g_checkpoints.size();
+		std::printf("  [%s] marker=%p ring=[%p, %p) %s\n", stage.c_str(),
+		            static_cast<const void*>(checkpoint),
+		            static_cast<const void*>(g_checkpoints.data()),
+		            static_cast<const void*>(g_checkpoints.data() + g_checkpoints.size()),
+		            in_ring ? "inside" : "OUTSIDE");
+		if (checkpoint == nullptr || !in_ring) {
+			continue;
+		}
+		Print(stage.c_str(), *checkpoint);
+	}
+	std::fflush(stdout);
+}
+
+}
