diff --git a/src/graphics/shader/recompiler/ir/GlcAtomicLoad.h b/src/graphics/shader/recompiler/ir/GlcAtomicLoad.h
new file mode 100644
index 0000000..399905a
--- /dev/null
+++ b/src/graphics/shader/recompiler/ir/GlcAtomicLoad.h
@@ -0,0 +1,26 @@
+#ifndef EMULATOR_SRC_GRAPHICS_SHADER_RECOMPILER_IR_GLCATOMICLOAD_H_
+#define EMULATOR_SRC_GRAPHICS_SHADER_RECOMPILER_IR_GLCATOMICLOAD_H_
+
+// Descriptor fix V7 (AnyPS5 #2259 port): KYTY_GLC_ATOMIC_LOAD=1 emits coherent (glc/dlc) aligned
+// BDA dword loads as Device-scope relaxed OpAtomicLoad instead of Volatile OpLoad.
+// Default OFF. Read once per process (there is no on-disk shader cache to invalidate).
+// Never bitcasts to uvec2 (NVIDIA compiler crash).
+
+#include <cstdlib>
+#include <cstring>
+
+namespace Libs::Graphics::ShaderRecompiler::IR {
+
+inline bool GlcAtomicLoadEnabled() {
+	static const bool enabled = [] {
+		const char* value = std::getenv("KYTY_GLC_ATOMIC_LOAD");
+		return value != nullptr &&
+		       (std::strcmp(value, "1") == 0 || std::strcmp(value, "on") == 0 ||
+		        std::strcmp(value, "ON") == 0 || std::strcmp(value, "true") == 0);
+	}();
+	return enabled;
+}
+
+} // namespace Libs::Graphics::ShaderRecompiler::IR
+
+#endif /* EMULATOR_SRC_GRAPHICS_SHADER_RECOMPILER_IR_GLCATOMICLOAD_H_ */
