+// V11: VOPC SDWA compares. Ace Combat 8 (PPSA24913) failed at pc 0x2400 with
+// raw=[0x7df300f9 0x86060019]: VOPC op 0xf9 = V_CMPX_NGE_F16, src0=SDWA, vsrc1=0x80 with S1=1
+// (inline constant 0), SDWA src0=v25 (S0=0), src0/src1 sel=DWORD, no sext/neg/abs.
+// GFX10 CMPX writes EXEC only.
+std::string DecodeVopcSdwaForTest(uint32_t word0, uint32_t word1) {
+  const uint32_t words[] = {word0, word1};
+  ShaderRecompiler::Decoder::Instruction inst{};
+  ShaderRecompiler::Decoder::DecodeInstruction(std::span<const uint32_t>(words), 0, inst);
+  return ShaderRecompiler::Decoder::InstructionToString(inst);
+}
+
+void TestNewShaderRecompilerVopcSdwaV11() {
+  struct Case {
+    uint32_t word0;
+    uint32_t word1;
+    const char *expected;
+  };
+  const Case cases[] = {
+      // Captured Ace Combat 8 instruction.
+      {0x7df300f9u, 0x86060019u, "V_CMPX_NGE_F16 exec_lo, v25, 0"},
+      // v_cmpx_nge_f16 with signed byte1 src0 and low-word src1.
+      {EncodeVopc(0xf9, 249, 6), EncodeVopcSdwa(5, 0, 0, 1, 4, 1, 0),
+       "V_CMPX_NGE_F16 exec_lo, v5.sdwa(sel=1,sext=1), v6.sdwa(sel=4,sext=0)"},
+      // v_cmp_u_f16 high word, explicit SGPR-pair destination (SD=1, sdst=s20).
+      {EncodeVopc(0xe8, 249, 6), EncodeVopcSdwa(5, 20, 1, 5, 6),
+       "V_CMP_U_F16 s20, v5.sdwa(sel=5,sext=0), v6"},
+      // v_cmpx_le_u16 with scalar src0 (S0=1) byte0 and sign-extended byte1 src1.
+      {EncodeVopc(0xbb, 249, 6), EncodeVopcSdwa(3, 0, 0, 0, 1, 0, 1, 0, 0, 0, 0, 1),
+       "V_CMPX_LE_U16 exec_lo, s3.sdwa(sel=0,sext=0), v6.sdwa(sel=1,sext=1)"},
+      // v_cmp_lt_i32 sign-extended byte2 src0, SD=0 -> vcc.
+      {EncodeVopc(0x81, 249, 6), EncodeVopcSdwa(5, 0, 0, 2, 6, 1),
+       "V_CMP_LT_I32 vcc_lo, v5.sdwa(sel=2,sext=1), v6"},
+      // v_cmp_nlg_f16 with scalar src1 (S1=1).
+      {EncodeVopc(0xea, 249, 7), EncodeVopcSdwa(5, 0, 0, 6, 6, 0, 0, 0, 0, 0, 0, 0, 1),
+       "V_CMP_NLG_F16 vcc_lo, v5, s7"},
+  };
+  for (const auto &entry : cases) {
+    const auto text = DecodeVopcSdwaForTest(entry.word0, entry.word1);
+    Check(text.find(entry.expected) != std::string::npos,
+          ("V11 VOPC SDWA decode mismatch: got '" + text + "' expected '" +
+           entry.expected + "'")
+              .c_str());
+    Check(text.find("unsupported") == std::string::npos,
+          ("V11 VOPC SDWA still unsupported: " + text).c_str());
+  }
+  // 64-bit compares have no SDWA encoding and stay rejected.
+  const auto cmp64 = DecodeVopcSdwaForTest(EncodeVopc(0xa1, 249, 6), EncodeVopcSdwa(5));
+  Check(cmp64.find("VOPC SDWA modifier is not supported for opcode") != std::string::npos,
+        "V11 VOPC SDWA unexpectedly accepted a 64-bit compare");
+
+  // The captured instruction and siblings must also translate end to end.
+  const uint32_t shader[] = {
+      0x7df300f9u, 0x86060019u, // v_cmpx_nge_f16 exec, v25, 0 (SDWA)
+      EncodeVopc(0xe8, 249, 6), EncodeVopcSdwa(5, 20, 1, 5, 6),
+      EncodeVopc(0xbb, 249, 6), EncodeVopcSdwa(3, 0, 0, 0, 1, 0, 1, 0, 0, 0, 0, 1),
+      EncodeVopc(0xcf, 5 + 256, 6), // v_cmp_o_f16 v5, v6
+      EncodeVopc(0xff, 5 + 256, 6), // v_cmpx_tru_f16 v5, v6
+      0xbf810000u,                  // s_endpgm
+  };
+  auto options = MakeCompileOptions(ShaderType::Compute);
+  options.dump_ir = true;
+  auto result = RecompileForTest(shader, options);
+  Check(result.decoded_dump.find("V_CMPX_NGE_F16") != std::string::npos,
+        "V11 captured V_CMPX_NGE_F16 SDWA missing from decoded dump");
+  Check(result.decoded_dump.find("unsupported") == std::string::npos,
+        "V11 VOPC SDWA shader still contains unsupported instructions");
+  Check(!result.spirv.empty(), "V11 VOPC SDWA shader produced no SPIR-V");
+}
